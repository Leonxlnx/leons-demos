---
import Icon from "./Icon.astro";
import { compact, posterSrcset, sizedImage, toolFilter, type ViewDemo } from "../lib/demos";

interface Props {
  demo: ViewDemo;
  eager?: boolean;
}
const { demo, eager = false } = Astro.props;
const tools = demo.tools.map(toolFilter);
const toolLabel = tools.map((t) => t.label).join(" and ");
// The picture is one grid column wide: at least 320px, up to four of them in 1680px.
const sizes = "(max-width: 699px) calc(100vw - 2rem), (max-width: 1057px) 47vw, (max-width: 1430px) 31vw, (max-width: 1679px) 25vw, 382px";
---

<article class="card" id={demo.id} data-id={demo.id} data-cat={demo.cat} data-tool={demo.toolIds}>
  <div class:list={["media", demo.crop === "top" && "media--top"]}>
    {
      demo.poster && (
        <img
          src={sizedImage(demo.poster, "small")}
          srcset={posterSrcset(demo)}
          sizes={sizes}
          alt=""
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
          decoding="async"
          width="680"
          height="425"
        />
      )
    }
    {
      demo.video && (
        <video data-src={demo.video} data-src-sm={demo.videoSm} muted loop playsinline preload="none" aria-hidden="true" />
      )
    }
  </div>
  <div class="body">
    <h2 class="title">
      <a href={demo.post_url} target="_blank" rel="noopener" title={demo.title}>{demo.shortTitle}</a>
    </h2>
    <div class="foot">
      <span class="likes" title={`${demo.likes.toLocaleString("en-US")} likes`}>
        <Icon name="heart" size={12} />{compact(demo.likes)}
        {
          tools.length > 0 && (
            <span class="tool" role="img" aria-label={toolLabel} title={toolLabel}>
              {tools.map((t) => (
                <Icon name={t.logo} size={12} />
              ))}
            </span>
          )
        }
      </span>
      <span class="links">
        {
          demo.links_.map((l) => (
            <a class:list={["btn", l.primary && "btn--primary"]} href={l.url} target="_blank" rel="noopener">
              {l.label}
            </a>
          ))
        }
        <a class="btn btn--icon" href={demo.post_url} target="_blank" rel="noopener" aria-label="View on X">
          <Icon name="x" size={12} />
        </a>
      </span>
    </div>
  </div>
</article>
