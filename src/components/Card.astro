---
import Icon from "./Icon.astro";
import { compact, sizedImage, TOOL_FILTERS, TOOL_LOGOS, type ViewDemo } from "../lib/demos";

interface Props {
  demo: ViewDemo;
  eager?: boolean;
}
const { demo, eager = false } = Astro.props;
const logos = TOOL_LOGOS[demo.tool];
const toolLabel = TOOL_FILTERS.find((f) => f.tool === demo.tool)?.label;
---

<article class="card" data-cat={demo.cat} data-tool={demo.toolId}>
  <div class="media">
    {
      demo.poster && (
        <img
          src={sizedImage(demo.poster, "small")}
          alt=""
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
          decoding="async"
          width="680"
          height="425"
        />
      )
    }
    {demo.video && <video data-src={demo.video} muted loop playsinline preload="none" aria-hidden="true" />}
  </div>
  <div class="body">
    <h2 class="title">
      <a href={demo.post_url} target="_blank" rel="noopener" title={demo.title}>{demo.shortTitle}</a>
    </h2>
    <div class="foot">
      <span class="likes" title={`${demo.likes.toLocaleString("en-US")} likes`}>
        <Icon name="heart" size={12} />{compact(demo.likes)}
        {
          logos.length > 0 && (
            <span class="tool" role="img" aria-label={toolLabel} title={toolLabel}>
              {logos.map((l) => (
                <Icon name={l} size={12} />
              ))}
            </span>
          )
        }
      </span>
      <span class="links">
        {
          demo.links_.map((l) => (
            <a class:list={["btn", l.primary && "btn--primary"]} href={l.url} target="_blank" rel="noopener">
              {l.label}
            </a>
          ))
        }
        <a class="btn btn--icon" href={demo.post_url} target="_blank" rel="noopener" aria-label="View on X">
          <Icon name="x" size={12} />
        </a>
      </span>
    </div>
  </div>
</article>
