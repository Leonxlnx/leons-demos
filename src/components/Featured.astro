---
import Icon from "./Icon.astro";
import { categoryShort, compact, sizedImage, CATEGORIES, cleanText, type ViewDemo } from "../lib/demos";

interface Props {
  demos: ViewDemo[];
}
const { demos } = Astro.props;
---

<div class="featured">
  {
    demos.map((d, i) => {
      const short = categoryShort(d.category);
      const catLabel = CATEGORIES.find((c) => c.id === d.category)?.label;
      const excerpt = cleanText(d.text).replace(/https?:\/\/t\.co\/\w+/g, "").replace(/\s+/g, " ").trim();
      return (
        <article class:list={["feat", i === 0 && "feat--lead"]} data-id={d.id}>
          <div class="feat-media" data-autoplay={d.video ?? undefined}>
            {d.thumb && (
              <img
                src={sizedImage(d.thumb, i === 0 ? "large" : "medium")}
                alt=""
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : "auto"}
                decoding="async"
              />
            )}
          </div>
          <div class="feat-shade" aria-hidden="true" />
          <div class="feat-body">
            <div class="feat-rank" aria-label={`Rank ${d.rank}`}>
              {String(d.rank).padStart(2, "0")}
            </div>
            <div class="feat-info">
              <div class="card-meta">
                <span class={`cat cat--${short}`}>{catLabel}</span>
                <time datetime={d.created_at}>{d.dateLabel}</time>
              </div>
              <h3 class="feat-title">
                <button type="button" class="card-open" data-open={d.id}>{d.title}</button>
              </h3>
              {i === 0 && <p class="feat-excerpt">{excerpt}</p>}
              <div class="card-foot">
                <div class="stats">
                  <span class="stat stat--likes"><Icon name="heart" size={14} />{d.likes.toLocaleString("en-US")}</span>
                  <span class="stat"><Icon name="repost" size={14} />{compact(d.reposts)}</span>
                  <span class="stat"><Icon name="eye" size={14} />{compact(d.views)}</span>
                </div>
                <div class="card-links">
                  {d.links_.map((l) => (
                    <a class={`pill pill--${l.kind}`} href={l.url} target="_blank" rel="noopener" title={l.url}>
                      {l.kind === "repo" ? <Icon name="github" size={12} /> : null}
                      {l.label}
                      {l.kind !== "repo" && <Icon name="arrow" size={11} />}
                    </a>
                  ))}
                  <a class="pill pill--x" href={d.post_url} target="_blank" rel="noopener" aria-label="View post on X">
                    <Icon name="x" size={12} />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </article>
      );
    })
  }
</div>
