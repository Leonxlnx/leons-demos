---
/*
 * earshot: ears for coding agents. Its picture is a listening: a waveform with a playhead that
 * sweeps it, the events it hears named as they pass, and the commands an agent runs, taken from
 * the README. Pressed and dragged with a mouse, the playhead follows the pointer.
 */
import Icon from "../Icon.astro";
import { compact } from "../../lib/format";
import type { ViewProject } from "../../lib/projects";

interface Props {
  project: ViewProject;
}
const { project } = Astro.props;

// A six second take, drawn like the launch film's: a run of key presses, notes, pops, two
// whooshes and a ding. Bars are the envelope at 120 points, deterministic.
const N = 120;
let seed = 5;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const events = [
  { at: 0.04, kind: "key", label: "mechanical key press" },
  { at: 0.2, kind: "note", label: "glockenspiel note" },
  { at: 0.36, kind: "pop", label: "bubble pop" },
  { at: 0.5, kind: "whoosh", label: "fast air whoosh" },
  { at: 0.7, kind: "whoosh", label: "fast air whoosh" },
  { at: 0.9, kind: "note", label: "ding" },
];
const bars = Array.from({ length: N }, (_, i) => {
  const t = i / (N - 1);
  let v = 0.06 + rnd() * 0.05;
  // key presses: a fast run of spikes early on
  if (t > 0.03 && t < 0.15 && i % 2 === 0) v = Math.max(v, 0.35 + rnd() * 0.25);
  for (const e of events) {
    const d = t - e.at;
    if (e.kind === "note" && d > 0 && d < 0.07) v = Math.max(v, 0.75 * Math.exp(-d * 40) + rnd() * 0.05);
    if (e.kind === "pop" && Math.abs(d) < 0.015) v = Math.max(v, 0.6);
    if (e.kind === "whoosh" && Math.abs(d) < 0.08) v = Math.max(v, 0.9 * Math.exp(-((d * 18) ** 2)) + rnd() * 0.06);
  }
  if (t > 0.5 && t < 0.62) v = Math.max(v, 0.32 + rnd() * 0.3);
  return Math.min(1, v);
});

const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
const LINES = [
  { cmd: "earshot describe enter.ogg", out: "0.56 s short transient. Sounds most like: a single mechanical keyboard key press" },
  { cmd: 'earshot find keys.ogg "a single mechanical key press"', out: "0:03.94-0:04.19 (0.24 s stroke, strong)" },
  { cmd: "earshot critique film.mp4", out: "VERDICT: close. 21 of 23 scored metrics in range" },
];
const TERM = LINES.map((l) => `<span class="prompt">$</span> ${esc(l.cmd)}\n<span class="out">${esc(l.out)}</span>`).join("\n\n");
---

<section class="ear wrap" aria-labelledby="ear-h">
  <div class="ear-copy">
    <h2 id="ear-h" class="work-h" data-reveal="line">
      <span class="line"><span>earshot</span></span>
    </h2>
    <p class="work-p" data-reveal="up" style="--d:80ms">Ears for coding agents. AI that can hear, review and make sound.</p>
    <p class="work-meta" data-reveal="up" style="--d:140ms">
      It tells an agent what a file sounds like, finds the moment it asked for and scores a film's sound against
      professional launch films. Runs on a CPU, as a CLI and an MCP server.
    </p>
    <div class="work-actions" data-reveal="up" style="--d:200ms">
      <a class="button" href={project.url} target="_blank" rel="noopener">
        Repository
        <Icon name="arrow-up-right" size={16} />
      </a>
      <a class="button quiet" href={project.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
        <Icon name="star" size={14} />
        <span data-repo={project.repo}><span class="count">{compact(project.stars)}</span></span>
      </a>
    </div>
  </div>

  <figure class="listen" data-listen data-reveal="up" style="--d:120ms">
    <div class="wave" aria-hidden="true">
      <div class="bars">
        {bars.map((v) => <span class="bar" style={`--v:${v.toFixed(3)}`} />)}
        <div class="sweep" />
      </div>
      <ol class="events">
        {
          events.map((e) => (
            <li style={`--at:${e.at}`} data-at={e.at}>
              {e.label}
            </li>
          ))
        }
      </ol>
    </div>
    <div class="listen-bar">
      <button class="button quiet play" type="button" data-play hidden>
        <Icon name="play" size={14} />
        <span class="play-label">Listen</span>
      </button>
      <span class="sr-only" role="status" aria-live="polite" data-play-status></span>
    </div>
    <pre class="term"><code set:html={TERM} /></pre>
    <figcaption class="sr-only">A listening timeline as earshot draws it, and three commands with their answers from the earshot README.</figcaption>
  </figure>
</section>

<script>
  /* The playhead sweeps the take every 9 seconds while the figure is on screen; pressed and
     dragged with a mouse, it follows the pointer instead. Bars it has passed are lit, and the
     event under it is named. All of it is one clock: the veil that is the playhead and the six
     names are Web Animations on transform and opacity, so the compositor runs the sweep and the
     main thread only starts, pauses or seeks them (a drag, the pause button, leaving the screen).
     Listen plays the take for real, six seconds made in code with Web Audio the way earshot forge
     makes its sounds: key presses (filtered noise clicks), a glockenspiel note and a ding (decaying
     sines with a bright partial), a pop (a falling sine) and two whooshes (noise through a swept
     band-pass). While it plays, the sweep runs at the take's pace from the audio's first sample;
     the button keeps its focus, marked aria-disabled, and a status line reads its state out. */
  const fig = document.querySelector<HTMLElement>("[data-listen]");
  const sweep = fig?.querySelector<HTMLElement>(".sweep");
  if (fig && sweep && "animate" in sweep) {
    const wave = fig.querySelector<HTMLElement>(".wave")!;
    const items = Array.from(fig.querySelectorAll<HTMLElement>(".events li"));
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const root = document.documentElement;
    // One idle sweep, in ms, and the take, in seconds.
    const LOOP = 9000;
    const T = 6;
    const REST = 0.54;
    const timing: KeyframeAnimationOptions = { duration: LOOP, iterations: Infinity, fill: "both" };
    const hidden = { opacity: 0, transform: "translateY(6px)" };
    const shown = { opacity: 1, transform: "none" };
    // A name fades in over 2.5% of the sweep as the playhead reaches it and holds for 12%.
    const anims = [
      sweep.animate([{ transform: "translateX(0%)" }, { transform: "translateX(100%)" }], timing),
      ...items.map((li) => {
        const at = Number(li.dataset.at);
        const on = Math.min(at + 0.025, 0.99);
        const off = Math.min(at + 0.12, 0.995);
        return li.animate(
          [
            { offset: 0, ...hidden },
            { offset: at, ...hidden },
            { offset: on, ...shown },
            { offset: off, ...shown },
            { offset: Math.min(off + 0.025, 1), ...hidden },
            { offset: 1, ...hidden },
          ],
          timing,
        );
      }),
    ];
    const seek = (p: number) => {
      for (const a of anims) {
        a.pause();
        a.currentTime = Math.min(0.9999, Math.max(0, p)) * LOOP;
      }
    };
    let visible = false;
    let held = false;
    let playing = false;
    // Runs the idle sweep when it may move, holds it where it is otherwise.
    const sync = () => {
      if (playing) return;
      if (reduced) return seek(REST);
      const go = visible && !held && !root.classList.contains("motion-paused");
      for (const a of anims) {
        if (go) a.play();
        else a.pause();
      }
    };
    seek(reduced ? REST : 0);

    let ctx: AudioContext | null = null;
    const button = fig.querySelector<HTMLButtonElement>("[data-play]");
    const label = button?.querySelector(".play-label");
    const status = fig.querySelector("[data-play-status]");

    function noise(ac: AudioContext, seconds: number) {
      const buf = ac.createBuffer(1, Math.ceil(ac.sampleRate * seconds), ac.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      const src = ac.createBufferSource();
      src.buffer = buf;
      return src;
    }
    function env(ac: AudioContext, at: number, peak: number, attack: number, decay: number, out: AudioNode) {
      const g = ac.createGain();
      g.gain.setValueAtTime(0.0001, at);
      g.gain.exponentialRampToValueAtTime(peak, at + attack);
      g.gain.exponentialRampToValueAtTime(0.0001, at + attack + decay);
      g.connect(out);
      return g;
    }
    function key(ac: AudioContext, at: number, out: AudioNode) {
      const n = noise(ac, 0.08);
      const hp = ac.createBiquadFilter();
      hp.type = "bandpass";
      hp.frequency.value = 2400 + Math.random() * 900;
      hp.Q.value = 1.2;
      n.connect(hp).connect(env(ac, at, 0.5, 0.002, 0.05, out));
      n.start(at);
      // The thock under the click.
      const o = ac.createOscillator();
      o.frequency.setValueAtTime(190, at);
      o.frequency.exponentialRampToValueAtTime(90, at + 0.05);
      o.connect(env(ac, at, 0.35, 0.002, 0.06, out));
      o.start(at);
      o.stop(at + 0.1);
    }
    function bell(ac: AudioContext, at: number, freq: number, decay: number, out: AudioNode) {
      for (const [mult, peak] of [
        [1, 0.32],
        [2.76, 0.1],
        [5.4, 0.04],
      ]) {
        const o = ac.createOscillator();
        o.frequency.value = freq * mult;
        o.connect(env(ac, at, peak, 0.004, decay / mult, out));
        o.start(at);
        o.stop(at + decay + 0.1);
      }
    }
    function pop(ac: AudioContext, at: number, out: AudioNode) {
      const o = ac.createOscillator();
      o.frequency.setValueAtTime(900, at);
      o.frequency.exponentialRampToValueAtTime(220, at + 0.07);
      o.connect(env(ac, at, 0.4, 0.003, 0.08, out));
      o.start(at);
      o.stop(at + 0.15);
    }
    function whoosh(ac: AudioContext, at: number, out: AudioNode) {
      const n = noise(ac, 0.8);
      const bp = ac.createBiquadFilter();
      bp.type = "bandpass";
      bp.Q.value = 0.9;
      bp.frequency.setValueAtTime(350, at);
      bp.frequency.exponentialRampToValueAtTime(3800, at + 0.38);
      bp.frequency.exponentialRampToValueAtTime(900, at + 0.7);
      const g = ac.createGain();
      g.gain.setValueAtTime(0.0001, at);
      g.gain.exponentialRampToValueAtTime(0.55, at + 0.34);
      g.gain.exponentialRampToValueAtTime(0.0001, at + 0.72);
      n.connect(bp).connect(g).connect(out);
      n.start(at);
    }
    async function listen() {
      // aria-disabled, not disabled: a disabled button would drop keyboard focus to the page.
      if (playing || button!.getAttribute("aria-disabled") === "true") return;
      const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (!AC) return;
      ctx ??= new AC();
      const ac = ctx;
      playing = true;
      if (label) label.textContent = "Listening";
      if (status) status.textContent = "Playing six seconds of sound";
      button!.setAttribute("aria-disabled", "true");
      await ac.resume().catch(() => {});
      const master = ac.createGain();
      master.gain.value = 0.42;
      master.connect(ac.destination);
      const t0 = ac.currentTime + 0.08;
      for (let i = 0; i < 6; i++) key(ac, t0 + T * 0.04 + i * 0.11 + Math.random() * 0.015, master);
      bell(ac, t0 + T * 0.2, 1568, 1.1, master);
      pop(ac, t0 + T * 0.36, master);
      whoosh(ac, t0 + T * 0.5 - 0.34, master);
      whoosh(ac, t0 + T * 0.7 - 0.34, master);
      bell(ac, t0 + T * 0.9, 2093, 1.6, master);
      // The sweep starts from 0 when the first sample sounds and crosses in T seconds.
      const lead = (t0 - ac.currentTime + (ac.outputLatency || 0)) * 1000;
      const start = Number(document.timeline.currentTime ?? performance.now()) + lead;
      for (const a of anims) {
        a.playbackRate = LOOP / 1000 / T;
        a.startTime = start;
      }
      setTimeout(() => {
        playing = false;
        for (const a of anims) a.playbackRate = 1;
        sync();
      }, lead + T * 1000);
      setTimeout(() => {
        if (label) label.textContent = "Listen again";
        if (status) status.textContent = "Finished playing";
        button!.removeAttribute("aria-disabled");
        master.disconnect();
      }, lead + (T + 0.4) * 1000);
    }
    if (button) {
      button.hidden = false;
      button.addEventListener("click", listen);
    }

    if (!reduced) {
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        sync();
      }).observe(fig);
      new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["class"] });
      // Pressed and dragged with a mouse, the playhead follows the pointer: the same animations,
      // seeked. A touch is left to scroll the page.
      let rect: DOMRect | null = null;
      const follow = (e: PointerEvent) => {
        if (rect && !playing) seek((e.clientX - rect.left) / rect.width);
      };
      wave.addEventListener("pointerdown", (e) => {
        if (e.pointerType !== "mouse" || e.button !== 0 || playing) return;
        // No text selection while dragging.
        e.preventDefault();
        wave.setPointerCapture(e.pointerId);
        rect = wave.getBoundingClientRect();
        held = true;
        follow(e);
      });
      wave.addEventListener("pointermove", (e) => {
        if (held) follow(e);
      });
      const release = () => {
        if (!held) return;
        held = false;
        rect = null;
        sync();
      };
      wave.addEventListener("pointerup", release);
      wave.addEventListener("pointercancel", release);
      wave.addEventListener("lostpointercapture", release);
    }
  }
</script>

<style>
  .ear {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 3rem;
    align-items: center;
    padding-top: var(--section);
  }
  .ear-copy {
    grid-column: 1 / span 6;
  }
  .ear-copy .work-p {
    margin-top: 2rem;
  }
  /* The listening sits on the ground like the copy, from the same left edge as the TasteCode
     and cinetic copy. */
  .listen {
    grid-column: 8 / -1;
    margin: 0;
  }
  .wave {
    position: relative;
    height: clamp(9rem, 16vw, 13rem);
  }
  @media (prefers-reduced-motion: no-preference) {
    .wave {
      cursor: ew-resize;
    }
  }
  .bars {
    position: absolute;
    inset: 0 0 2.25rem;
    display: flex;
    align-items: center;
    gap: 2px;
    overflow: hidden;
  }
  .bar {
    flex: 1;
    height: 100%;
    border-radius: 2px;
    background: #ededed;
    transform: scaleY(max(0.04, var(--v)));
  }
  /* Bars the playhead has passed are lit; the rest wait in a dim grey. The grey is one veil in
     the ground's colour (--bg) at 78%, the same as each bar at 22% opacity, and its left edge is
     the playhead. Only the veil moves, by transform, so the 120 bars are drawn once and never
     restyled. Without the script it rests a little past the middle. */
  .sweep {
    position: absolute;
    inset: 0;
    background: rgb(10 10 10 / 0.78);
    transform: translateX(54%);
  }
  .sweep::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 2px;
    background: #ededed;
  }
  .events {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Each name is anchored in proportion to its own width (at 0 its left edge, at 1 its right),
     so it never leaves the wave. The script fades it in and out on the playhead's clock. */
  .events li {
    position: absolute;
    left: calc(var(--at) * 100%);
    color: var(--text);
    font-size: var(--step-small);
    white-space: nowrap;
    opacity: 0;
    translate: calc(var(--at) * -100%) 0;
    transform: translateY(6px);
  }
  .listen-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.25rem;
  }
  .listen .play {
    padding-inline: 1.2rem;
  }
  .play[hidden] {
    display: none;
  }
  /* While the take plays the button rests: it keeps focus but takes no press. */
  .play[aria-disabled="true"] {
    cursor: default;
    transform: none;
  }
  /* On a phone every second bar goes, so the rest keep a real width. */
  @media (max-width: 560px) {
    .bar:nth-child(2n) {
      display: none;
    }
  }
  .term {
    margin: 1.5rem 0 0;
    padding: 1.25rem 0 0;
    overflow-x: auto;
    border-top: 0;
    color: var(--text);
    font-size: var(--step-small);
    line-height: 1.6;
    white-space: pre-wrap;
    scrollbar-width: none;
  }
  .term code {
    font-family: var(--mono);
  }
  .term :global(.prompt),
  .term :global(.out) {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .ear-copy,
    .listen {
      grid-column: 1 / -1;
    }
  }
</style>
