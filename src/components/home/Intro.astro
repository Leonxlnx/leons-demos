---
/*
 * The hero and the about section, one scene. The hero is one dense collage around Leon seen
 * from behind: the three models he builds with as glass tiles round his head, a ring of metal
 * through them, his laptop with TasteCode open, the towers of the Frauenkirche over his
 * shoulder, a tablet of photographs from his week, and his guitar and football in front. With
 * motion allowed and a screen the hero fits, intro.ts pins the two as one stage: scrolling, the
 * hero leaves, the collage flies apart, the tiles sink behind his shoulders and come back up as
 * one cluster beside the about text, thick and turned. Without the script the about section
 * simply follows the hero, with its own still tiles.
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import Icon from "../Icon.astro";
import Nav from "../Nav.astro";
import Ring from "./Ring.astro";

interface Props {
  email: string;
}
const { email } = Astro.props;

interface Piece {
  id: string;
  kind: "tile" | "cut";
  /** Desktop place in the 1000x600 collage, in percent: left, top, width; rotation in degrees. */
  d: [number, number, number, number];
  /** Phone place in the 1000x1000 collage. */
  m: [number, number, number, number];
  /** How far it rises ahead of the page as the hero scrolls away (phones). */
  z: number;
  /** Stacking: behind the figure (1, 2) or in front of it (4, 5). */
  layer: number;
  /** A turn in depth for flat photographs, so they face the figure. */
  tilt?: number;
  tile?: { icon: "claude" | "openai" | "gemini"; name: string; rx: number; ry: number };
  img?: { src: string; srcset?: string; w: number; h: number; alt: string };
}

// Photographs (public/home/v2, transparent, greyscale, one shared tone curve). A missing file
// drops its piece.
const v2 = (file: string) => existsSync(join(process.cwd(), "public", "home", "v2", file));
// Each has a small file (sm: its width) for phones.
const CUT = {
  laptop: { w: 1397, h: 1113, sm: 640, alt: "TasteCode, Leon's desktop app for coding agents, open on a laptop" },
  tablet: { w: 1200, h: 867, sm: 640, alt: "A tablet with three photographs: the Frauenkirche, an ice hockey faceoff and a hand playing guitar" },
  towers: { w: 620, h: 699, sm: 320, alt: "The towers of the Frauenkirche in Munich" },
  guitar: { w: 488, h: 1100, sm: 240, alt: "An archtop electric guitar" },
  football: { w: 520, h: 515, sm: 240, alt: "A football" },
};
const cut = (id: keyof typeof CUT) => {
  if (!v2(`${id}.webp`)) return undefined;
  const { sm, ...img } = CUT[id];
  const srcset = v2(`${id}-sm.webp`) ? `/home/v2/${id}-sm.webp ${sm}w, /home/v2/${id}.webp ${img.w}w` : undefined;
  return { src: `/home/v2/${id}.webp`, srcset, ...img };
};
/** Drawn width of a collage piece: a share of the phone collage (32rem at most) or of the wide one. */
const STACKED = "(max-width: 860px) or (max-aspect-ratio: 4/5)";
const sizes = (desktop: number, phone: number) => `${STACKED} calc(min(100vw, 32rem) * ${phone / 100}), calc(min(100vw, 1500px) * ${desktop / 100})`;
const ME_SRCSET = v2("me-sm.png") ? "/home/v2/me-sm.png 800w, /home/v2/me.png 1400w" : undefined;

// Claude stands behind his head, ChatGPT and Gemini lean in from either side; the laptop and the
// towers stand behind his shoulders, the tablet, guitar and football come forward.
const ALL: Piece[] = [
  { id: "claude", kind: "tile", d: [39, 1, 22, -3], m: [36.5, 13, 27, -3], z: 0.5, layer: 1, tile: { icon: "claude", name: "Claude", rx: 14, ry: 0 } },
  { id: "openai", kind: "tile", d: [21.5, 13, 20, -9], m: [11, 23, 26, -9], z: 0.7, layer: 2, tile: { icon: "openai", name: "ChatGPT", rx: 10, ry: 24 } },
  { id: "gemini", kind: "tile", d: [58.5, 9, 20, 8], m: [63, 21, 26, 8], z: 0.7, layer: 2, tile: { icon: "gemini", name: "Gemini", rx: 10, ry: -24 } },
  { id: "laptop", kind: "cut", d: [3, 38, 36, -4], m: [-6, 51, 44, -4], z: 0.9, layer: 2, tilt: 14, img: cut("laptop") },
  { id: "towers", kind: "cut", d: [72, 17, 21, 3], m: [72, 40, 26, 3], z: 0.8, layer: 2, img: cut("towers") },
  { id: "tablet", kind: "cut", d: [61, 52, 35, 5], m: [53, 67, 45, 5], z: 1.2, layer: 4, tilt: -12, img: cut("tablet") },
  { id: "guitar", kind: "cut", d: [28, 47, 13, -10], m: [27, 57, 15, -12], z: 1.1, layer: 4, img: cut("guitar") },
  { id: "football", kind: "cut", d: [12, 76, 12.5, 0], m: [3, 81, 17, 0], z: 1.3, layer: 5, img: cut("football") },
];
const PIECES = ALL.filter((p) => p.kind === "tile" || p.img);

/** About tiles, one cluster: place in the models box (left, top, width in percent), tilt in degrees, stacking. */
const MODELS = [
  { icon: "openai", d: [6, 8, 40], rx: 16, ry: 28, rz: -7, zi: 1 },
  { icon: "gemini", d: [52, 2, 40], rx: 18, ry: -28, rz: 7, zi: 1 },
  { icon: "claude", d: [28, 42, 43], rx: 24, ry: -6, rz: -2, zi: 2 },
] as const;
const SLABS = 12;

/** Photographs behind the cluster, turned toward it like panes of glass, with smaller files for phones. */
const PANELS = [
  { id: "alps", alt: "", side: "l" },
  { id: "munich", alt: "", side: "r" },
]
  .filter((p) => v2(`${p.id}.webp`))
  .map((p) => ({
    ...p,
    srcset: [
      v2(`${p.id}-sm.webp`) && `/home/v2/${p.id}-sm.webp 360w`,
      v2(`${p.id}-md.webp`) && `/home/v2/${p.id}-md.webp 600w`,
      `/home/v2/${p.id}.webp 900w`,
    ]
      .filter(Boolean)
      .join(", "),
  }));

// Entrance order: the tiles round his head first, then what stands behind him, then the front.
const order = ["claude", "openai", "gemini", "towers", "laptop", "tablet", "guitar", "football"];
const style = (p: Piece) =>
  [
    `--x:${p.d[0]}%`,
    `--y:${p.d[1]}%`,
    `--w:${p.d[2]}%`,
    `--r:${p.d[3]}deg`,
    `--mx:${p.m[0]}%`,
    `--my:${p.m[1]}%`,
    `--mw:${p.m[2]}%`,
    `--mr:${p.m[3]}deg`,
    `--z:${p.layer}`,
    `--dz:${p.z}`,
    `--i:${order.indexOf(p.id) + 1}`,
    `--tilt:${p.tilt ?? 0}deg`,
    p.img ? `--ar:${p.img.w}/${p.img.h}` : "--ar:1",
  ].join(";");
---

<div class="intro" data-intro>
  <script is:inline>
    if (
      matchMedia("(prefers-reduced-motion: no-preference) and (min-width: 861px) and (min-height: 36rem)").matches &&
      !matchMedia("(max-aspect-ratio: 4/5)").matches
    )
      document.documentElement.classList.add("scene");
  </script>
  <div class="stage">
    <section class="hero paper" aria-labelledby="name">
      <div class="hero-top wrap">
        <h1 id="name" class="name"><span class="line"><span>Leon</span></span> <span class="line"><span>Lin</span></span></h1>
        <div class="aside">
          <div class="aside-top">
            <p class="where">
              <span>Munich</span>
              <time class="clock" data-clock hidden></time>
            </p>
            <Nav path="/" />
          </div>
          <div class="intro-text" id="hero-foot">
            <p class="lede">I build tools that give AI good taste.</p>
            <p class="sub">Creator of Taste Skill, high school student in Munich.</p>
            <div class="actions">
              <a class="button" href={`mailto:${email}`}>
                Email me
                <Icon name="arrow" size={16} />
              </a>
              <a class="button quiet x" href="https://x.com/LexnLin" target="_blank" rel="noopener" aria-label="@LexnLin on X">
                <Icon name="x" size={16} />
                <span class="x-handle">@LexnLin</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-body">
        <div class="collage" data-collage>
          <Ring id="hero" half="back" class="hero-ring" />
          <img
            class="me"
            src="/home/v2/me.png"
            srcset={ME_SRCSET}
            sizes={ME_SRCSET && sizes(52, 72)}
            alt="Leon, seen from behind"
            width="1400"
            height="1343"
            fetchpriority="high"
            decoding="async"
            data-piece="me"
          />
          <Ring id="hero" half="front" class="hero-ring" />
          {
            PIECES.map((p) => (
              <figure
                class:list={["piece", `is-${p.kind}`]}
                style={style(p)}
                data-piece={p.id}
                aria-hidden={p.kind === "tile" ? "true" : undefined}
              >
                <span class="piece-in">
                  {p.kind === "tile" && (
                    <span
                      class="tile"
                      data-tile={p.tile!.icon}
                      data-rx={p.tile!.rx}
                      data-ry={p.tile!.ry}
                      style={`--rx:${p.tile!.rx}deg;--ry:${p.tile!.ry}deg`}
                    >
                      <span class="tile-body">
                        {Array.from({ length: SLABS }, (_, k) => (
                          <span class="slab" style={`--k:${k + 1}`} />
                        ))}
                        <span class="face" />
                        <span class="glyph glyph-shadow">
                          <Icon name={p.tile!.icon} size={24} />
                        </span>
                        <span class="glyph">
                          <Icon name={p.tile!.icon} size={24} />
                        </span>
                      </span>
                    </span>
                  )}
                  {p.kind === "cut" && (
                    <img
                      class="cut"
                      src={p.img!.src}
                      srcset={p.img!.srcset}
                      sizes={p.img!.srcset && sizes(p.d[2], p.m[2])}
                      alt={p.img!.alt}
                      width={p.img!.w}
                      height={p.img!.h}
                      decoding="async"
                      draggable="false"
                    />
                  )}
                </span>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about paper" aria-labelledby="about-h" data-about>
      <div class="about-in wrap">
        <div class="about-copy">
          <h2 id="about-h" class="about-h" data-reveal="line">
            <span class="line"><span>I turn ideas into</span></span>
            <span class="line" style="--l:1"><span><strong>real tools</strong> with AI.</span></span>
          </h2>
          <p class="about-p" data-reveal="up" style="--d:160ms">
            Every day I build with AI. Most of it starts as an experiment and ends up on X. A few took off.
          </p>
          <div class="about-go" data-reveal="up" style="--d:240ms">
            <a class="button" href="https://x.com/LexnLin" target="_blank" rel="noopener">
              <Icon name="x" size={16} />
              Follow on X
            </a>
          </div>
        </div>
        <div class="models" data-models aria-hidden="true">
          {
            PANELS.map((p) => (
              <img
                class:list={["panel", `panel-${p.side}`]}
                src={`/home/v2/${p.id}.webp`}
                srcset={p.srcset}
                sizes={`${STACKED} 5.5rem, min(16vw, 17rem)`}
                alt={p.alt}
                width="900"
                height="1200"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
                draggable="false"
              />
            ))
          }
          <Ring id="about" half="back" class="about-ring" />
          {
            MODELS.map((m, i) => (
              <div
                class="slot"
                data-slot={m.icon}
                style={`--x:${m.d[0]}%;--y:${m.d[1]}%;--w:${m.d[2]}%;--rx:${m.rx}deg;--ry:${m.ry}deg;--rz:${m.rz}deg;--zi:${m.zi};--i:${i}`}
              >
                <span class="tile">
                  <span class="tile-body">
                    {Array.from({ length: SLABS }, (_, k) => (
                      <span class="slab" style={`--k:${k + 1}`} />
                    ))}
                    <span class="face" />
                    <span class="glyph glyph-shadow">
                      <Icon name={m.icon} size={24} />
                    </span>
                    <span class="glyph">
                      <Icon name={m.icon} size={24} />
                    </span>
                  </span>
                </span>
              </div>
            ))
          }
          <Ring id="about" half="front" class="about-ring" />
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  import "../../scripts/intro";
</script>

<style>
  /* ------------------------------------------------------------ hero */

  .hero {
    --name: min(18.4vw, 30svh, 23.5rem);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100svh;
    min-height: 36rem;
    padding-top: clamp(1.25rem, 3vw, 2rem);
    overflow: clip;
  }
  /* The name on the left; the nav and the intro stand in the column beside it, the intro on the
     name's baseline. */
  .hero-top {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  /* The h1's box ends exactly on Geist's baseline (0.755em in a 0.8 line box). "Leon Lin" has
     no descenders. */
  .name {
    align-self: end;
    height: 0.755em;
    margin: 0 0 0 -0.045em;
    font-size: var(--name);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .name .line {
    display: inline-block;
    vertical-align: top;
    padding-bottom: 0;
    margin-bottom: 0;
  }
  @supports (height: 1lh) {
    .name {
      height: auto;
      margin-bottom: calc(0.355em - 0.5lh);
    }
  }
  .aside {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-width: 0;
  }
  .aside-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.25rem;
  }
  .intro-text {
    max-width: 25rem;
    padding-bottom: 0.15rem;
  }
  .lede {
    margin: 0;
    font-size: var(--step-lead);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .sub {
    margin: 0.6rem 0 0;
    color: var(--paper-muted);
    font-size: var(--step-body);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .x {
    padding-inline: 1.2rem;
  }

  /* The body is a size container: the collage takes the largest 1000x600 box that fits and
     stands on the bottom edge, so the figure is cut by the end of the screen. */
  .hero-body {
    position: relative;
    width: 100%;
    max-width: 1680px;
    margin-inline: auto;
    container-type: size;
  }
  .collage {
    --cw: min(100cqw - 2 * var(--pad), 166.7cqh, 1500px);
    position: absolute;
    bottom: 0;
    left: 50%;
    width: var(--cw);
    aspect-ratio: 1000 / 600;
    translate: -50% 0;
  }
  .me {
    position: absolute;
    top: 27.5%;
    left: 23%;
    z-index: 3;
    width: 52%;
    height: auto;
    user-select: none;
    pointer-events: none;
  }
  /* The ring circles his head: its back half behind the tiles, its front half across his neck. */
  .collage :global(.hero-ring) {
    top: 26.5%;
    left: 10%;
    z-index: 0;
    width: 80%;
    rotate: -12deg;
    mask-image: linear-gradient(90deg, transparent 4%, #000 22%, #000 78%, transparent 96%);
  }
  .collage :global(.hero-ring.ring-front) {
    z-index: 3;
  }
  .piece {
    position: absolute;
    top: var(--y);
    left: var(--x);
    z-index: var(--z);
    width: var(--w);
    margin: 0;
  }
  /* Every piece throws a soft shadow on what lies behind it, from a light above and a little to
     the left, so the collage reads as objects in one space rather than stickers. */
  .piece-in {
    display: block;
    rotate: var(--r);
    filter: drop-shadow(0 18px 22px rgba(0, 0, 0, 0.16)) drop-shadow(0 3px 5px rgba(0, 0, 0, 0.12));
  }
  /* Tiles carry their own shadow (the back slab), so turning one never repaints a filter. */
  .is-tile .piece-in {
    filter: none;
  }
  .cut {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar);
    transform: perspective(1600px) rotateY(var(--tilt));
    user-select: none;
  }

  /* ------------------------------------------------------------ tiles */

  /* A tile is a block of frosted glass: twelve slabs behind the face build its thickness, the
     glyph stands a little in front of it. --depth is the thickness, --rx/--ry the tilt; the
     hero shows them thin, the about section thick and turned. */
  .tile {
    --depth: 14px;
    --rz: 0deg;
    display: block;
    aspect-ratio: 1;
    perspective: 900px;
  }
  .tile-body {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(var(--rz));
  }
  .slab,
  .face,
  .glyph {
    position: absolute;
    inset: 0;
    border-radius: 23%;
  }
  /* The edge of the glass: clear and bright at the face, a little denser toward the back, and
     see-through, so a turned tile shows its edge as layered glass. */
  .slab {
    background: color-mix(in srgb, rgb(150 150 150 / 0.72) calc(var(--k) / 12 * 100%), rgb(246 246 246 / 0.62));
    transform: translateZ(calc(var(--depth) * var(--k) / -12));
  }
  .slab:nth-child(12) {
    box-shadow:
      0 16px 30px -6px rgba(0, 0, 0, 0.24),
      0 4px 8px rgba(0, 0, 0, 0.1);
  }
  .slot .slab:nth-child(12) {
    box-shadow:
      0 28px 48px -10px rgba(0, 0, 0, 0.24),
      0 6px 12px rgba(0, 0, 0, 0.1);
  }
  /* The face: frosted glass lit from the upper left, with a bright rim, a darker lower bevel
     and a streak of light across it. */
  .face {
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 8% 0%, rgba(255, 255, 255, 0.95), transparent 55%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(248, 248, 248, 0.86) 42%, rgba(226, 226, 226, 0.84) 100%);
    box-shadow:
      inset 0 1.5px 0 #fff,
      inset 0 0 0 1px rgba(255, 255, 255, 0.85),
      inset 0 -3px 0 rgba(0, 0, 0, 0.05),
      inset 0 -18px 30px rgba(0, 0, 0, 0.06);
  }
  .face::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, transparent 30%, rgba(255, 255, 255, 0.8) 44%, transparent 56%);
  }
  /* The logo: one crisp layer standing off the glass, over a soft shadow of itself. */
  .glyph {
    display: grid;
    place-items: center;
    color: var(--paper-ink);
    transform: translateZ(calc(var(--depth) * 0.16));
  }
  .glyph-shadow {
    opacity: 0.22;
    filter: blur(3px);
    transform: translateZ(calc(var(--depth) * 0.02)) translateY(3%);
  }
  .glyph :global(.icon) {
    width: 46%;
    height: 46%;
  }

  /* ------------------------------------------------------------ Munich */

  .where {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    color: var(--paper-muted);
    font-size: var(--step-body);
  }
  .where span {
    color: var(--paper-ink);
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }

  /* ------------------------------------------------------------ about */

  .about {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--section, 8rem);
    overflow: clip;
  }
  .about-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
  }
  .about-copy {
    position: relative;
    z-index: 4;
    grid-column: 1 / span 5;
  }
  .about-h {
    margin: 0;
    font-size: var(--step-heading);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .about-h strong {
    font-weight: 600;
  }
  .about-p {
    max-width: 27rem;
    margin: 1.75rem 0 0;
    color: var(--paper-muted);
    font-size: clamp(1.0625rem, 0.98rem + 0.3vw, 1.25rem);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .about-go {
    margin-top: 2rem;
  }
  .about-go .button {
    gap: 0.6rem;
    padding-inline: 1.35rem;
  }

  /* The cluster: three tiles close together, a ring through them and two photographs behind,
     turned toward them. Isolated, so its back layers stay over the section's paper. */
  .models {
    position: relative;
    grid-column: 6 / -1;
    aspect-ratio: 1 / 0.9;
    isolation: isolate;
  }
  .slot {
    position: absolute;
    top: var(--y);
    left: var(--x);
    z-index: var(--zi);
    width: var(--w);
  }
  /* The still tiles take their slot's tilt (the scene sets its own on the flying ones). */
  .slot .tile {
    --depth: 34px;
    --rx: inherit;
    --ry: inherit;
    --rz: inherit;
  }
  .models :global(.about-ring) {
    --ring-rim: 17;
    --ring-tube: 12;
    --ring-glint: 2.4;
    top: 49%;
    left: -6%;
    z-index: -1;
    width: 112%;
    rotate: -10deg;
  }
  .models :global(.about-ring.ring-front) {
    z-index: 3;
  }
  .panel {
    position: absolute;
    z-index: -1;
    width: 28%;
    height: auto;
    aspect-ratio: 3 / 4;
    border-radius: 1.1rem;
    object-fit: cover;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.6) inset,
      0 30px 50px -20px rgba(0, 0, 0, 0.3);
    user-select: none;
  }
  .panel-l {
    top: 46%;
    left: -2%;
    transform: perspective(900px) rotateY(32deg) rotateZ(-2deg);
  }
  .panel-r {
    top: 38%;
    left: 73%;
    transform: perspective(900px) rotateY(-32deg) rotateZ(2deg);
  }

  /* ------------------------------------------------------------ the scene */

  /* html.scene runs the pinned version (an inline script above sets it before the first paint,
