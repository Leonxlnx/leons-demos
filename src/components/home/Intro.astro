---
/*
 * The hero and the about section, one scene. The hero is one dense collage around Leon seen
 * from behind: the three models he builds with as tiles behind his head, his laptop with
 * TasteCode open, the towers of the Frauenkirche over his shoulder, a screen of photographs from
 * his week, and his guitar, football and hockey stick in front. With motion allowed and a screen
 * the hero fits, intro.ts pins the two as one stage: scrolling, the hero leaves, the collage
 * flies apart, the tiles sink behind his shoulders and come back up beside the about text as
 * solid, tilted objects. Without the script the about section simply follows the hero, with
 * its own still tiles.
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import Icon from "../Icon.astro";
import Nav from "../Nav.astro";

interface Props {
  email: string;
}
const { email } = Astro.props;

type Kind = "tile" | "cut" | "laptop" | "screen";
interface Piece {
  id: string;
  kind: Kind;
  /** Desktop place in the 1000x600 collage, in percent: left, top, width; rotation in degrees. */
  d: [number, number, number, number];
  /** Phone place in the 1000x1000 collage. */
  m: [number, number, number, number];
  /** Parallax depth under the pointer. */
  z: number;
  /** Stacking: behind the figure (1, 2) or in front of it (4, 5). */
  layer: number;
  tile?: { icon: "claude" | "openai" | "gemini"; name: string };
  img?: { src: string; w: number; h: number; alt: string };
}

// Cut-outs (public/home/cut, transparent, grey). A missing file drops its piece.
const CUT = {
  towers: { w: 661, h: 745, alt: "The towers of the Frauenkirche in Munich" },
  guitar: { w: 1064, h: 2400, alt: "An archtop electric guitar" },
  football: { w: 926, h: 917, alt: "A football" },
  hockey: { w: 1064, h: 698, alt: "An ice hockey stick and a puck" },
};
const cut = (id: keyof typeof CUT) =>
  existsSync(join(process.cwd(), "public", "home", "cut", `${id}.webp`)) ? { src: `/home/cut/${id}.webp`, ...CUT[id] } : undefined;

const ALL: Piece[] = [
  { id: "openai", kind: "tile", d: [22, 14, 19, -9], m: [8, 14, 26, -9], z: 0.7, layer: 1, tile: { icon: "openai", name: "ChatGPT" } },
  { id: "gemini", kind: "tile", d: [59.5, 11, 19, 8], m: [65, 11, 26, 8], z: 0.7, layer: 1, tile: { icon: "gemini", name: "Gemini" } },
  { id: "claude", kind: "tile", d: [39.5, 3, 22, -3], m: [36, 4, 29, -3], z: 0.5, layer: 2, tile: { icon: "claude", name: "Claude" } },
  { id: "laptop", kind: "laptop", d: [6, 42, 34, -4], m: [-5, 50, 41, -4], z: 0.9, layer: 2 },
  { id: "towers", kind: "cut", d: [75.5, 31, 15.5, 4], m: [71, 44, 23, 4], z: 0.8, layer: 1, img: cut("towers") },
  { id: "screen", kind: "screen", d: [65, 58, 31, 5], m: [57, 69, 43, 5], z: 1.2, layer: 4 },
  { id: "guitar", kind: "cut", d: [26, 44, 11.5, -14], m: [24, 55, 13.5, -14], z: 1.1, layer: 4, img: cut("guitar") },
  { id: "football", kind: "cut", d: [9.5, 76, 11, 0], m: [2, 83, 15, 0], z: 1.3, layer: 5, img: cut("football") },
  { id: "hockey", kind: "cut", d: [54, 65, 30, -8], m: [38, 71, 44, -8], z: 1.4, layer: 5, img: cut("hockey") },
];
const PIECES = ALL.filter((p) => p.kind !== "cut" || p.img);

// The screen shows a week in photographs, one large and two small; the laptop shows his app.
const SHOTS = [
  { src: "/home/hockey.webp", alt: "An ice hockey faceoff" },
  { src: "/home/guitar.webp", alt: "A hand strumming a guitar" },
  { src: "/home/munich.webp", alt: "The Frauenkirche between two buildings" },
];

/** About tiles: place in the models box (left, top, width in percent) and tilt in degrees. */
const MODELS = [
  { icon: "openai", name: "ChatGPT", d: [2, 4, 33], rx: 20, ry: 30, rz: -6 },
  { icon: "gemini", name: "Gemini", d: [63, 0, 33], rx: 22, ry: -30, rz: 6 },
  { icon: "claude", name: "Claude", d: [30, 44, 38], rx: 28, ry: -10, rz: -3 },
] as const;
const SLABS = 12;

// Entrance order: the tiles round his head first, then what stands behind him, then the front.
const order = ["claude", "openai", "gemini", "towers", "laptop", "screen", "guitar", "hockey", "football"];
const style = (p: Piece) =>
  [
    `--x:${p.d[0]}%`,
    `--y:${p.d[1]}%`,
    `--w:${p.d[2]}%`,
    `--r:${p.d[3]}deg`,
    `--mx:${p.m[0]}%`,
    `--my:${p.m[1]}%`,
    `--mw:${p.m[2]}%`,
    `--mr:${p.m[3]}deg`,
    `--z:${p.layer}`,
    `--dz:${p.z}`,
    `--i:${order.indexOf(p.id) + 1}`,
    p.img ? `--ar:${p.img.w}/${p.img.h}` : "--ar:1",
  ].join(";");
---

<div class="intro" data-intro>
  <div class="stage">
    <section class="hero paper" aria-labelledby="name">
      <div class="hero-top wrap">
        <h1 id="name" class="name"><span class="line"><span>Leon</span></span> <span class="line"><span>Lin</span></span></h1>
        <div class="aside">
          <div class="aside-top">
            <p class="where">
              <span>Munich</span>
              <time class="clock" data-clock hidden></time>
            </p>
            <Nav path="/" />
          </div>
          <div class="intro-text" id="hero-foot">
            <p class="lede">I build tools that give AI good taste.</p>
            <p class="sub">Creator of Taste Skill, high school student in Munich.</p>
            <div class="actions">
              <a class="button" href={`mailto:${email}`}>
                Email me
                <Icon name="arrow" size={16} />
              </a>
              <a class="button quiet x" href="https://x.com/LexnLin" target="_blank" rel="noopener" aria-label="@LexnLin on X">
                <Icon name="x" size={16} />
                <span class="x-handle">@LexnLin</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-body">
        <div class="collage" data-collage>
          <img
            class="me"
            src="/home/me.png"
            alt="Leon, seen from behind"
            width="1200"
            height="1520"
            fetchpriority="high"
            decoding="async"
            data-piece="me"
          />
          {
            PIECES.map((p) => (
              <figure
                class:list={["piece", `is-${p.kind}`]}
                style={style(p)}
                data-piece={p.id}
                data-depth={p.z}
                aria-hidden={p.kind === "tile" ? "true" : undefined}
              >
                <span class="piece-in">
                  {p.kind === "tile" && (
                    <span class="tile" data-tile={p.tile!.icon}>
                      <span class="tile-body">
                        {Array.from({ length: SLABS }, (_, k) => (
                          <span class="slab" style={`--k:${k + 1}`} />
                        ))}
                        <span class="face">
                          <Icon name={p.tile!.icon} size={24} />
                        </span>
                        {[1, 2, 3, 4].map((j) => (
                          <span class="glyph" style={`--j:${j}`}>
                            <Icon name={p.tile!.icon} size={24} />
                          </span>
                        ))}
                      </span>
                    </span>
                  )}
                  {p.kind === "cut" && (
                    <img class="cut" src={p.img!.src} alt={p.img!.alt} width={p.img!.w} height={p.img!.h} decoding="async" draggable="false" />
                  )}
                  {p.kind === "laptop" && (
                    <span class="laptop">
                      <span class="laptop-body">
                        <span class="lid">
                          <img
                            src="/work/tastecode-app.webp"
                            alt="TasteCode, Leon's desktop app for coding agents, open on a laptop"
                            width="1280"
                            height="720"
                            decoding="async"
                            draggable="false"
                          />
                        </span>
                        <span class="deck" />
                      </span>
                    </span>
                  )}
                  {p.kind === "screen" && (
                    <span class="screen">
                      <span class="screen-body">
                        {SHOTS.map((s) => (
                          <img src={s.src} alt={s.alt} width="720" height="540" decoding="async" draggable="false" />
                        ))}
                      </span>
                    </span>
                  )}
                </span>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about paper" aria-labelledby="about-h" data-about>
      <div class="about-in wrap">
        <div class="about-copy">
          <h2 id="about-h" class="about-h" data-reveal="line">
            <span class="line"><span>I turn ideas into</span></span>
            <span class="line" style="--l:1"><span>tools with AI.</span></span>
          </h2>
          <p class="about-p" data-reveal="up" style="--d:160ms">
            I'm Leon, a high school student in Munich. Every day I build with Claude, ChatGPT and Gemini: skills that give
            coding agents taste, a desktop app to run them, sound and films made from code. Away from the screen I play
            guitar, hockey and football.
          </p>
          <ul class="ways">
            {
              [
                ["Explore", "New models the week they ship, pushed until they break."],
                ["Build", "Skills, apps and films, made in the open."],
                ["Share", "Every demo goes on X, with how it was made."],
              ].map(([h, t], i) => (
                <li data-reveal="up" style={`--d:${260 + i * 80}ms`}>
                  <h3>{h}</h3>
                  <p>{t}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="models" data-models>
          {
            MODELS.map((m, i) => (
              <div
                class="slot"
                data-slot={m.icon}
                style={`--x:${m.d[0]}%;--y:${m.d[1]}%;--w:${m.d[2]}%;--rx:${m.rx}deg;--ry:${m.ry}deg;--rz:${m.rz}deg;--i:${i}`}
              >
                <span class="tile" aria-hidden="true">
                  <span class="tile-body">
                    {Array.from({ length: SLABS }, (_, k) => (
                      <span class="slab" style={`--k:${k + 1}`} />
                    ))}
                    <span class="face">
                      <Icon name={m.icon} size={24} />
                    </span>
                    {[1, 2, 3, 4].map((j) => (
                      <span class="glyph" style={`--j:${j}`}>
                        <Icon name={m.icon} size={24} />
                      </span>
                    ))}
                  </span>
                </span>
                <span class="slot-name">{m.name}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  import "../../scripts/intro";
</script>

<style>
  /* ------------------------------------------------------------ hero */

  .hero {
    --name: min(18.4vw, 30svh, 23.5rem);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100svh;
    min-height: 36rem;
    padding-top: clamp(1.25rem, 3vw, 2rem);
    overflow: clip;
  }
  /* The name on the left; the nav and the intro stand in the column beside it, the intro on the
     name's baseline. */
  .hero-top {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  /* The h1's box ends exactly on Geist's baseline (0.755em in a 0.8 line box). "Leon Lin" has
     no descenders. */
  .name {
    align-self: end;
    height: 0.755em;
    margin: 0 0 0 -0.045em;
    font-size: var(--name);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .name .line {
    display: inline-block;
    vertical-align: top;
    padding-bottom: 0;
    margin-bottom: 0;
  }
  @supports (height: 1lh) {
    .name {
      height: auto;
      margin-bottom: calc(0.355em - 0.5lh);
    }
  }
  .aside {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-width: 0;
  }
  .aside-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.25rem;
  }
  .intro-text {
    max-width: 25rem;
    padding-bottom: 0.15rem;
  }
  .lede {
    margin: 0;
    font-size: var(--step-lead);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .sub {
    margin: 0.6rem 0 0;
    color: var(--paper-muted);
    font-size: var(--step-body);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .x {
    padding-inline: 1.2rem;
  }

  /* The body is a size container: the collage takes the largest 1000x600 box that fits and
     stands on the bottom edge, so the figure is cut by the end of the screen. */
  .hero-body {
    position: relative;
    width: 100%;
    max-width: 1680px;
    margin-inline: auto;
    container-type: size;
  }
  .collage {
    --cw: min(100cqw - 2 * var(--pad), 166.7cqh, 1500px);
    position: absolute;
    bottom: 0;
    left: 50%;
    width: var(--cw);
    aspect-ratio: 1000 / 600;
    translate: -50% 0;
  }
  .me {
    position: absolute;
    top: 24%;
    left: 29%;
    z-index: 3;
    width: 42%;
    height: auto;
    user-select: none;
    pointer-events: none;
  }
  .piece {
    position: absolute;
    top: var(--y);
    left: var(--x);
    z-index: var(--z);
    width: var(--w);
    margin: 0;
  }
  .piece-in {
    display: block;
    rotate: var(--r);
    transition:
      translate 700ms cubic-bezier(0.34, 1.4, 0.64, 1),
      rotate 700ms cubic-bezier(0.34, 1.4, 0.64, 1),
      scale 700ms cubic-bezier(0.34, 1.4, 0.64, 1),
      opacity 400ms var(--ease-out);
  }
  .cut {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar);
    user-select: none;
  }

  /* Pointing at a piece lifts it straight; the rest of the collage steps back. */
  .collage.has-focus .piece:not(.is-on) .piece-in {
    opacity: 0.35;
  }
  .piece.is-on .piece-in {
    translate: 0 -12px;
    rotate: 0deg;
    scale: 1.06;
  }
  .piece.is-on {
    z-index: 6;
  }

  /* ------------------------------------------------------------ the laptop and the screen */

  /* Both are drawn flat in the page's greys and turned in 3D, so they sit in the collage at the
     same angles as the tiles. Their pictures are real: TasteCode, and photographs. */
  .laptop,
  .screen {
    display: block;
    perspective: 1100px;
  }
  .laptop-body {
    display: block;
    transform: rotateY(20deg) rotateX(5deg);
    transform-origin: 30% 60%;
  }
  .lid {
    display: block;
    padding: 3.4% 3.4% 4.6%;
    border-radius: 4.5% 4.5% 1.5% 1.5% / 7% 7% 2% 2%;
    background: #141414;
  }
  .lid img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    border-radius: 1.2%;
    object-fit: cover;
    object-position: left top;
    filter: grayscale(1);
  }
  .deck {
    display: block;
    height: 0;
    margin: 0 -7%;
    padding-top: 4.5%;
    border-radius: 0 0 46% 46% / 0 0 100% 100%;
    background: #3b3b3b;
  }
  .screen-body {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 1.6%;
    aspect-ratio: 16 / 10;
    padding: 2.4%;
    border-radius: 3% / 4.8%;
    background: #0e0e0e;
    transform: rotateY(-22deg) rotateX(4deg);
    transform-origin: 70% 60%;
  }
  .screen-body img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    border-radius: 2.5% / 3.6%;
    object-fit: cover;
  }
  .screen-body img:first-child {
    grid-row: span 2;
  }

  /* ------------------------------------------------------------ tiles */

  /* A tile is a stack: twelve slabs behind the face build its thickness, the glyph stands a
     little in front of it. --depth is the thickness, --rx/--ry the tilt; the hero shows them
     thin and almost flat, the about section thick and turned. */
  .tile {
    --depth: 8px;
    --rx: 12deg;
    --ry: 0deg;
    --rz: 0deg;
    display: block;
    aspect-ratio: 1;
    perspective: 900px;
  }
  .tile-body {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(var(--rz));
  }
  .slab,
  .face,
  .glyph {
    position: absolute;
    inset: 0;
    border-radius: 23%;
  }
  .slab {
    background: color-mix(in srgb, #8c8c8c calc(var(--k) / 12 * 100%), #d6d6d6);
    transform: translateZ(calc(var(--depth) * var(--k) / -12));
  }
  .face {
    display: grid;
    place-items: center;
    background: #fbfbfb;
    color: #d0d0d0;
  }
  /* The logo stands off the face in four layers, grey to ink, so a turned tile shows its
     thickness too. */
  .glyph {
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--paper-ink) calc((var(--j) - 1) / 3 * 100%), #a8a8a8);
    transform: translateZ(calc(var(--depth) * 0.07 * var(--j)));
  }
  .face :global(.icon),
  .glyph :global(.icon) {
    width: 46%;
    height: 46%;
  }

  /* ------------------------------------------------------------ Munich */

  .where {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    color: var(--paper-muted);
    font-size: var(--step-body);
  }
  .where span {
    color: var(--paper-ink);
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }

  /* ------------------------------------------------------------ about */

  .about {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--section, 8rem);
    overflow: clip;
  }
  .about-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
  }
  .about-copy {
    grid-column: 1 / span 5;
  }
  .about-h {
    margin: 0;
    font-size: var(--step-heading);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .about-p {
    max-width: 34rem;
    margin: 2rem 0 0;
    font-size: clamp(1.0625rem, 0.98rem + 0.3vw, 1.25rem);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    margin: clamp(2.5rem, 5vh, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .ways h3 {
    margin: 0;
    font-size: var(--step-body);
    font-weight: 500;
  }
  .ways p {
    margin: 0.4rem 0 0;
    color: var(--paper-muted);
    font-size: var(--step-small);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .models {
    position: relative;
    grid-column: 7 / -1;
    aspect-ratio: 1 / 0.92;
  }
  .slot {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: var(--w);
  }
  /* The still tiles take their slot's tilt (the scene sets its own on the flying ones). */
  .slot .tile {
    --depth: 34px;
    --rx: inherit;
    --ry: inherit;
    --rz: inherit;
  }
  .slot-name {
    display: block;
    margin-top: 2.5rem;
    color: var(--paper-muted);
    font-size: var(--step-body);
    text-align: center;
  }

  /* ------------------------------------------------------------ the scene */

  /* intro.ts adds html.scene when it runs the pinned version: the two sections share one
     stage, the about tiles become the targets the hero tiles fly to, and their names wait. */
  :global(.scene) .intro {
    height: 260svh;
  }
  :global(.scene) .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
    background: var(--paper);
  }
  /* The about section lies over the hero; the tiles cross from behind the figure into it. */
  :global(.scene) .about {
    position: absolute;
    inset: 0;
    z-index: 2;
    min-height: 0;
    padding-block: 0;
    background: none;
    pointer-events: none;
  }
  :global(.scene) .about.is-here {
    pointer-events: auto;
  }
  /* Until the scene reaches it the about text is transparent (it stays in the accessibility tree
     and find-in-page; nothing in it can take focus). */
  :global(.scene) .about:not(.is-here) .about-copy {
    opacity: 0;
  }
  :global(.scene) .slot .tile {
    visibility: hidden;
  }
  :global(.scene) .slot-name {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out);
  }
  :global(.scene) .about.is-settled .slot-name {
    opacity: 1;
    transform: none;
    transition-delay: calc(240ms + var(--i) * 80ms);
  }
  :global(.scene) .piece,
  :global(.scene) .me,
  :global(.scene) .hero-top,
  :global(.scene) .side {
    will-change: transform, opacity;
  }

  /* ------------------------------------------------------------ entrance */

  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.js) .name .line > span {
      transform: translateY(105%);
      animation: line-up var(--t-hero) var(--ease-out) 120ms forwards;
    }
    :global(.js) .name .line:last-child > span {
      animation-delay: 190ms;
    }
    :global(.js) .aside-top,
    :global(.js) .intro-text > * {
      animation: rise 800ms var(--ease-out) backwards;
      animation-delay: 420ms;
    }
    :global(.js) .intro-text > :nth-child(2) {
      animation-delay: 490ms;
    }
    :global(.js) .intro-text > :nth-child(3) {
      animation-delay: 560ms;
    }
    /* The collage comes up from below the screen, piece by piece: the figure first, then the
