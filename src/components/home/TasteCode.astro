---
/*
 * TasteCode: the app itself. Its window lies back in perspective and stands up as it scrolls
 * into the middle of the screen, then rests as a plain picture, drawn 1:1 on a 2x screen. Phones
 * get the chat column at its own size instead of the whole window shrunk to a smudge.
 */
import Icon from "../Icon.astro";
import { compact } from "../../lib/format";
import type { ViewProject } from "../../lib/projects";

interface Props {
  project: ViewProject;
}
const { project } = Astro.props;
---

<section class="tc wrap" aria-labelledby="tc-h">
  <div class="tc-head">
    <div class="tc-name drift">
      <img class="tc-icon" src="/work/tastecode-icon.webp" alt="" width="192" height="192" loading="lazy" decoding="async" data-reveal="up" />
      <h2 id="tc-h" class="work-h" data-reveal="line">
        <span class="line"><span>TasteCode</span></span>
      </h2>
    </div>
    <div class="tc-copy">
      <p class="work-p" data-reveal="up" style="--d:80ms">Taste Skill as a desktop app, with a design agent built in.</p>
      <p class="work-meta" data-reveal="up" style="--d:140ms">
        Codex, Claude Code and Grok in one local workspace. Windows and macOS, free and open source.
      </p>
      <div class="work-actions" data-reveal="up" style="--d:200ms">
        <a class="button" href="https://github.com/Leonxlnx/tastecode/releases/latest" target="_blank" rel="noopener">
          Download
          <Icon name="arrow-up-right" size={16} />
        </a>
        <a class="button quiet" href={project.url} target="_blank" rel="noopener">
          <Icon name="star" size={14} />
          <span data-repo={project.repo}><span class="count">{compact(project.stars)}</span></span>
          <span class="sr-only">stars on GitHub</span>
        </a>
      </div>
    </div>
  </div>
  <div class="tc-stage">
    <figure class="tc-window">
      <picture>
        <source
          media="(max-width: 560px)"
          type="image/avif"
          srcset="/work/tastecode-phone-sm.avif 720w, /work/tastecode-phone.avif 1120w"
          sizes="calc(100vw - 2rem)"
          width="1120"
          height="1460"
        />
        <source media="(max-width: 560px)" type="image/webp" srcset="/work/tastecode-phone.webp" width="1120" height="1460" />
        <source
          type="image/avif"
          srcset="/work/tastecode-app-sm.avif 1600w, /work/tastecode-app.avif 2880w"
          sizes="min(100vw - 2rem, (100vh - 7rem) * 1.6, 100rem)"
        />
        <img
          src="/work/tastecode-app.webp"
          alt="The TasteCode window: a coding agent's finished answer, the code it wrote and the four files it edited"
          width="2880"
          height="1800"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>
  </div>
</section>

<style>
  .tc {
    padding-top: var(--section);
  }
  .tc-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2rem;
    align-items: end;
  }
  .tc-name {
    display: flex;
    grid-column: 1 / span 7;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  .tc-icon {
    flex: none;
    width: clamp(3.5rem, 6vw, 6rem);
    height: auto;
  }
  .tc-copy {
    grid-column: 8 / -1;
  }
  .tc-stage {
    margin-top: clamp(3rem, 6vw, 5rem);
    perspective: 1600px;
    perspective-origin: 50% 0%;
  }
  /* The window keeps some of the screen around it: never taller than the screen less 7rem. */
  .tc-window {
    width: min(100%, (100vh - 7rem) * 1.6);
    width: min(100%, (100svh - 7rem) * 1.6);
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: #111;
    /* The window's own hairline edge, which the picture leaves out. */
    box-shadow: var(--edge-dark);
    transform-origin: 50% 100%;
  }
  .tc-window picture,
  .tc-window img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The window lies back and stands up as it reaches the middle of the screen. It fills backwards
     only: past the middle the animation lets go, so the window is no longer a scaled layer and
     its text rasterises at full resolution. The tilt has no scale in it for the same reason. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tc-window {
        animation: stand-up linear backwards;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }
    }
  }
  @keyframes stand-up {
    from {
      transform: rotateX(32deg) translateY(4rem);
      opacity: 0.4;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @media (max-width: 860px) {
    .tc-name,
    .tc-copy {
      grid-column: 1 / -1;
    }
  }
</style>
