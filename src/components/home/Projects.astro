---
/* More on GitHub: the open-source index. Each row is a link; focus lays a band behind it. */
import Icon from "../Icon.astro";
import { compact } from "../../lib/format";
import type { ViewProject } from "../../lib/projects";

interface Props {
  projects: ViewProject[];
}
const { projects } = Astro.props;
---

<section class="oss wrap" aria-labelledby="oss-h">
  <div class="oss-head">
    <h2 id="oss-h" class="oss-h" data-reveal="line">
      <span class="line"><span>More on GitHub</span></span>
    </h2>
    <a class="ink all" href="https://github.com/Leonxlnx" target="_blank" rel="noopener" data-reveal="up">All repositories</a>
  </div>
  <ul class="index">
    {
      projects.map((p) => (
        <li data-reveal="entry">
          <a class="entry" href={p.url} target="_blank" rel="noopener">
            <span class="entry-name">
              <span>{p.name}</span>
            </span>
            <span class="entry-note">{p.note}</span>
            <span class="entry-stars" data-repo={p.repo}>
              <Icon name="star" size={14} />
              <span class="count">{compact(p.stars)}</span>
              <span class="sr-only">stars</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .oss {
    padding-top: var(--section);
  }
  .oss-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .oss-h {
    margin: 0;
    font-size: var(--step-heading);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .all {
    flex: none;
    padding-block: 0.6rem;
    margin-block: -0.6rem;
    color: var(--muted);
    white-space: nowrap;
    font-size: var(--step-body);
  }
  .all:focus-visible {
    color: var(--text);
  }
  .index {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: baseline;
    padding-block: clamp(0.55rem, 1.1vw, 0.9rem);
    isolation: isolate;
  }
  /* Focus lays a filled band behind an entry's row, nudges its name and brings its note up to
     full ink. The rest of the list stays as it is. */
  .entry::before {
    content: "";
    position: absolute;
    /* It reaches a little past the text, but stays 4px inside the page's edge on phones. */
    inset: 0 calc(-1 * min(1rem, var(--pad) - 4px));
    z-index: -1;
    border-radius: 12px;
    background: var(--surface);
    opacity: 0;
    transition: opacity var(--t-ui) var(--ease-out);
  }
  /* Focus rings the band itself, so the ring and the fill share one shape. */
  .entry:focus-visible {
    outline: none;
  }
  .entry:focus-visible::before {
    outline: 2px solid var(--text);
  }
  .entry-name {
    display: block;
    grid-column: 1 / 7;
    overflow: clip;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    font-size: var(--step-title);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .entry-name > span {
    display: block;
    transition: translate var(--t-ui) var(--ease-out);
  }
  .entry:focus-visible .entry-name > span {
    translate: 0.375rem 0;
  }
  .entry-note {
    grid-column: 7 / 12;
    color: var(--muted);
    font-size: var(--step-body);
    line-height: 1.45;
    text-wrap: pretty;
    transition: color var(--t-hover) var(--ease-out);
  }
  .entry-stars {
    display: inline-flex;
    grid-column: 12;
    justify-self: end;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: var(--step-body);
    font-variant-numeric: tabular-nums;
    transition: color var(--t-hover) var(--ease-out);
  }
  .entry:focus-visible::before {
    opacity: 1;
  }
  .entry:focus-visible .entry-note,
  .entry:focus-visible .entry-stars {
    color: var(--text);
  }
  @media (max-width: 1100px) {
    .entry-name {
      grid-column: 1 / -1;
    }
    .entry-note {
      grid-column: 1 / 11;
      margin-top: 0.4rem;
    }
    .entry-stars {
      grid-column: 11 / -1;
    }
  }
  @media (max-width: 700px) {
    .entry {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .entry-name {
      grid-column: 1 / -1;
      white-space: normal;
      overflow-wrap: anywhere;
    }
    .entry-note {
      grid-column: 1;
    }
    .entry-stars {
      grid-column: 2;
    }
  }
  @media (max-width: 480px) {
    .oss-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
