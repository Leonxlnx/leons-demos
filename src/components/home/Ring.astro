---
/*
 * One half of a ring of polished metal that circles a group of things: the back half passes
 * behind them, the front half in front, so the group reads as one object in one space. Place
 * both halves on the same box. --ring-rim, --ring-tube and --ring-glint set its weight (in units
 * of a 1000-wide ring). It is still: whoever places it fades or moves the box, so the SVG itself
 * is painted once, its soft shadow included (an SVG filter is rasterised with the paint, where a
 * CSS filter would cost a pass on every frame the box moves). Decorative.
 */
interface Props {
  id: string;
  half: "back" | "front";
  class?: string;
}
const { id, half, class: cls } = Astro.props;
const g = `ring-${id}-${half}`;
const shade = `${g}-shade`;
---

<svg class:list={["ring", `ring-${half}`, cls]} viewBox="0 0 1000 240" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={g} x1="0" y1="0" x2="1" y2="0.2">
      <stop offset="0" stop-color="#8c8c8c"></stop>
      <stop offset="0.16" stop-color="#f6f6f6"></stop>
      <stop offset="0.38" stop-color="#7a7a7a"></stop>
      <stop offset="0.56" stop-color="#efefef"></stop>
      <stop offset="0.78" stop-color="#6c6c6c"></stop>
      <stop offset="1" stop-color="#d8d8d8"></stop>
    </linearGradient>
    <filter id={shade} x="-5%" y="-30%" width="110%" height="170%">
      <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000" flood-opacity="0.1"></feDropShadow>
    </filter>
  </defs>
  <g class="body" filter={`url(#${shade})`}>
    <ellipse class="rim" cx="500" cy="120" rx="492" ry="112"></ellipse>
    <ellipse class="tube" cx="500" cy="120" rx="492" ry="112" stroke={`url(#${g})`}></ellipse>
    <ellipse class="glint" cx="500" cy="117.5" rx="490" ry="110"></ellipse>
  </g>
</svg>

<style>
  .ring {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }
  /* Each half shows its side of the long axis; the box is turned as a whole, so the cut turns
     with it. The back half sits a little further into the haze. */
  .ring-back {
    clip-path: inset(-20% -2% 50% -2%);
  }
  .ring-back .body {
    opacity: 0.8;
  }
  .ring-front {
    clip-path: inset(50% -2% -20% -2%);
  }
  ellipse {
    fill: none;
    stroke-linecap: round;
  }
  .rim {
    stroke: rgba(0, 0, 0, 0.16);
    stroke-width: var(--ring-rim, 8.5);
  }
  .tube {
    stroke-width: var(--ring-tube, 6);
  }
  .glint {
    stroke: rgba(255, 255, 255, 0.95);
    stroke-width: var(--ring-glint, 1.4);
  }
</style>
