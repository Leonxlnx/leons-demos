---
/*
 * The close: the demos, as a drifting reel of stills in grey and a way into /demos, then the
 * reach-out footer, which ends on the email set as large as the name: its last line's
 * descender is the last row of the page.
 */
import Icon from "../Icon.astro";
import { DEMOS, posterSrcset, sizedImage, type ViewDemo } from "../../lib/demos";

interface Props {
  email: string;
}
const { email } = Astro.props;
const [user, domain] = email.split("@");

// The reel, picked by hand for frames that hold up small and in grey: no white grounds (they
// vanish into the paper), no black or blurred first frames, no stacked clips, nothing from a
// video under 720p (its compression shows). Each still opens its card on /demos.
const REEL = [
  "2096263046918197609",
  "2110389810258968965",
  "2111582260818239777",
  "2096518467105308782",
  "2078160372029071527",
  "2096166277849239804",
  "2102834362530079093",
  "2108159248148611292",
  "2096982947639468284",
  "2105704408898003333",
  "2109779693792883178",
  "2102133072585965759",
  "2106493673425047896",
  "2108694114476650840",
  "2086540718235910272",
  "2098024285512343979",
];
const reel = REEL.map((id) => DEMOS.find((d) => d.id === id)).filter((d): d is ViewDemo & { poster: string } => !!d?.poster);
// A still is 1.6 times as wide as it is tall: 135px tall on a phone, else 24svh within 160-260px.
const sizes = "(max-width: 860px) 216px, (max-height: 666px) 256px, (max-height: 1083px) 38.4vh, 416px";
---

<section class="demos paper" aria-labelledby="demos-h">
  <div class="demos-head wrap">
    <h2 id="demos-h" class="demos-h drift" data-reveal="line">
      <span class="line"><span>Demos</span></span>
    </h2>
    <div class="demos-copy">
      <a class="button" href="/demos" data-reveal="up" style="--d:80ms">
        See all {DEMOS.length} demos
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>
  {
    /* A preview: the button above is the way in for keyboards and screen readers. The second
       list repeats the first so the loop has no seam. */
  }
  <div class="reel" aria-hidden="true">
    <div class="reel-track">
      {
        [0, 1].map(() => (
          <ul class="reel-set">
            {reel.map((d) => (
              <li>
                <a class="still" href={`/demos#${d.id}`} tabindex="-1">
                  <img
                    src={sizedImage(d.poster, "small")}
                    srcset={posterSrcset(d)}
                    sizes={sizes}
                    alt=""
                    width="416"
                    height="260"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

{/* The page's pause button, from index.astro: between the two, so it parks under the reel. */}
<slot />

<footer class="close paper" aria-labelledby="close-h">
  <div class="contact wrap grid12">
    <p class="contact-h" data-reveal="up">Building something? Let's talk.</p>
    <div class="contact-side">
      <ul class="pills">
        <li data-reveal="up" style="--d:80ms">
          <a class="button quiet" href="https://x.com/LexnLin" target="_blank" rel="noopener">
            <Icon name="x" size={15} />
            @LexnLin
          </a>
        </li>
        <li data-reveal="up" style="--d:150ms">
          <a class="button quiet" href="https://github.com/Leonxlnx" target="_blank" rel="noopener">
            <Icon name="github" size={16} />
            Leonxlnx
          </a>
        </li>
      </ul>
    </div>
  </div>
  <h2 id="close-h" class="email wrap" data-reveal="line">
    <a href={`mailto:${email}`} aria-label={`Email ${email}`}>
      <span class="line"><span>{user}@</span></span><span class="line" style="--l:1"><span>{domain}</span></span>
    </a>
  </h2>
</footer>

<style>
  /* ------------------------------------------------------------ demos */

  .demos {
    padding-block: var(--section) var(--reel-foot);
    overflow-x: clip;
  }
  .demos-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .demos-h {
    grid-column: 1 / span 6;
    margin: 0;
    font-size: var(--step-section);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  .demos-copy {
    display: flex;
    grid-column: 8 / -1;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding-bottom: 0.5rem;
  }
  /* The reel: stills in grey, one size, in a loop. */
  .reel {
    --gap: 12px;
    overflow: hidden;
  }
  .reel-track,
  .reel-set {
    display: flex;
    gap: var(--gap);
  }
  .reel-track {
    width: max-content;
  }
  .reel-set {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .still {
    display: block;
    height: clamp(160px, 24svh, 260px);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--paper-2);
  }
  .still img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: opacity 400ms var(--ease-out);
  }
  /* A picture on its way waits unseen and fades in when it lands; the page script marks it. */
  .still img:global(.is-waiting) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .reel-track {
      animation: reel 120s linear infinite;
    }
    /* With the page script the reel is a Web Animation instead, which eases to a stop and
       picks up the scroll. */
    .reel:global(.is-js) .reel-track {
      animation: none;
      will-change: transform;
    }
    :global(.motion-paused) .reel-track {
      animation-play-state: paused;
    }
  }
  /* Holding still, the reel is a strip to scroll by hand, and the copy that closes the loop
     goes. */
  @media (prefers-reduced-motion: reduce) {
    .reel {
      overflow-x: auto;
      padding-inline: var(--pad);
      scrollbar-width: none;
    }
    .reel-set + .reel-set {
      display: none;
    }
  }
  @keyframes reel {
    to {
      transform: translateX(calc(-50% - var(--gap) / 2));
    }
  }

  /* ------------------------------------------------------------ close */

  /* The close ends on the email: its last line's descender is the last row of the page, or of
     what the iPhone's home indicator leaves free (the inset is 0 elsewhere). */
  .close {
    display: flex;
    flex-direction: column;
    padding-top: clamp(4rem, 9vw, 8rem);
    padding-bottom: env(safe-area-inset-bottom);
    overflow-x: clip;
  }
  .contact {
    row-gap: 2rem;
    align-items: end;
  }
  .contact-h {
    grid-column: 1 / span 6;
    margin: 0;
    font-size: var(--step-title, clamp(1.75rem, 0.8rem + 2.4vw, 3rem));
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .contact-side {
    display: flex;
    grid-column: 8 / -1;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* In a 0.86 line box the baseline sits 0.785em down and the g's tail ends 0.095em below the
     box, so the last line's padding makes that tail the page's final row. */
  /* Block margins only, so the wrap keeps it centred on wide screens, under the name. */
  .email {
    margin-block: clamp(3rem, 7svh, 5rem) 0;
    font-size: var(--step-monument);
    font-weight: 500;
    line-height: 0.86;
    letter-spacing: -0.055em;
  }
  .email a {
    display: block;
    margin-left: -0.045em;
    overflow-wrap: anywhere;
    transition: color var(--t-ui) var(--ease-out);
  }
  /* The ring stands clear of the letters. Its lower edge falls past the page's end, under the
     g's tail, so it reads as three sides. */
  .email a:focus-visible {
    outline-offset: clamp(4px, 0.04em, 10px);
    color: #474747;
  }
  .email .line:last-child {
    padding-bottom: 0.095em;
    margin-bottom: 0;
  }
  @media (min-width: 701px) {
    /* The email steps down the page like the two lines of a name. */
    .email .line:last-child {
      text-align: right;
    }
  }

  @media (max-width: 860px) {
    .demos-h,
    .demos-copy,
    .contact-h,
    .contact-side {
      grid-column: 1 / -1;
    }
    .still {
      height: 135px;
    }
  }
  @media (max-width: 700px) {
    .email {
      font-size: calc((100vw - 2 * var(--pad)) / 4.36);
    }
  }
</style>
