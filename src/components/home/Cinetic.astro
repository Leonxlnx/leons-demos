---
/*
 * cinetic: films made from code. The lead film's screen opens to the full width as it scrolls in,
 * and its colour develops once it holds the middle of the screen; the two smaller films develop
 * under the mouse. Films play muted, only while on screen, and stop with the pause button.
 */
import Icon from "../Icon.astro";
import { compact } from "../../lib/format";
import type { ViewProject } from "../../lib/projects";

interface Props {
  project: ViewProject;
}
const { project } = Astro.props;
---

<section class="cin" aria-labelledby="cin-h">
  <div class="cin-head wrap">
    <h2 id="cin-h" class="work-h" data-reveal="line">
      <span class="line"><span>cinetic</span></span>
    </h2>
    <div class="cin-copy">
      <p class="work-p" data-reveal="up" style="--d:80ms">Launch films and motion design from code, directed by your coding agent.</p>
      <div class="work-actions" data-reveal="up" style="--d:160ms">
        <a class="button" href={project.url} target="_blank" rel="noopener">
          Repository
          <Icon name="arrow-up-right" size={16} />
        </a>
        <a class="button quiet" href={project.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <Icon name="star" size={14} />
          <span data-repo={project.repo}><span class="count">{compact(project.stars)}</span></span>
        </a>
      </div>
    </div>
  </div>

  <div class="screen-wrap">
    <figure class="screen film" data-film data-lead>
      <video src="/work/cinetic/kiln.mp4" poster="/work/cinetic/kiln.webp" muted loop playsinline preload="none" aria-hidden="true"></video>
      <figcaption>
        <span>Kiln</span>
        <span class="cap-note">A 25 second launch teaser, branded, scored and rendered by an agent from a two-sentence brief</span>
      </figcaption>
    </figure>
  </div>

  <div class="more wrap">
    <figure class="film tall" data-film data-reveal="up">
      <video src="/work/cinetic/quire.mp4" poster="/work/cinetic/quire.webp" muted loop playsinline preload="none" aria-hidden="true"></video>
      <figcaption><span>Quire</span><span class="cap-note">A vertical feature film</span></figcaption>
    </figure>
    <figure class="film wide" data-film data-reveal="up" style="--d:90ms">
      <video src="/work/cinetic/ledgerly.mp4" poster="/work/cinetic/ledgerly.webp" muted loop playsinline preload="none" aria-hidden="true"></video>
      <figcaption><span>Ledgerly</span><span class="cap-note">A feature loop</span></figcaption>
    </figure>
    <p class="more-note" data-reveal="up" style="--d:180ms">
      Every film starts as three concepts, a beat grid and a soundtrack made with earshot, then gets checked frame by
      frame before it ships.
    </p>
  </div>
</section>

<script>
  /* Films load and play only while on screen and while motion is allowed; the lead film keeps
     its colour only while it holds the middle of the screen. */
  const films = Array.from(document.querySelectorAll<HTMLElement>("[data-film]"));
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const root = document.documentElement;
  const visible = new Set<HTMLElement>();
  const sync = () => {
    const paused = root.classList.contains("motion-paused");
    for (const f of films) {
      const v = f.querySelector("video")!;
      if (visible.has(f) && !paused && !reduced && !document.hidden) {
        if (v.preload === "none") v.preload = "auto";
        v.play().catch(() => {});
      } else v.pause();
    }
  };
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const f = e.target as HTMLElement;
          if (e.isIntersecting) visible.add(f);
          else visible.delete(f);
        }
        sync();
      },
      { threshold: 0.25 },
    );
    films.forEach((f) => io.observe(f));
    const lead = films.find((f) => f.hasAttribute("data-lead"));
    if (lead)
      new IntersectionObserver(([e]) => lead.classList.toggle("is-lit", e.isIntersecting), {
        rootMargin: "-30% 0px -30% 0px",
      }).observe(lead);
  }
  document.addEventListener("visibilitychange", sync);
  new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["class"] });
</script>

<style>
  .cin {
    padding-top: var(--section);
  }
  .cin-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2rem;
    align-items: end;
  }
  .cin-head .work-h {
    grid-column: 1 / span 6;
  }
  .cin-copy {
    grid-column: 8 / -1;
  }

  .film {
    position: relative;
    margin: 0;
  }
  .film video {
    display: block;
    width: 100%;
    height: auto;
    background: #111;
    filter: grayscale(1);
    transition: filter calc(4 * var(--step-fast)) steps(4, jump-none);
  }
  .film:global(.is-lit) video {
    filter: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .film:hover video {
      filter: none;
    }
  }
  .film figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 0.9rem;
    font-size: var(--step-body);
    line-height: 1.4;
  }
  .cap-note {
    color: var(--muted);
  }

  /* The lead screen opens from a framed picture to the full width as it scrolls in. */
  .screen-wrap {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .screen video {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .screen figcaption {
    padding-inline: var(--pad);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .screen video {
        animation: open-up linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }
  @keyframes open-up {
    from {
      clip-path: inset(0 18% 0 18% round 14px);
      transform: translateY(4rem);
    }
    to {
      clip-path: inset(0 0 0 0 round 0);
      transform: none;
    }
  }

  .more {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2.5rem;
    align-items: start;
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .tall {
    grid-column: 1 / span 3;
  }
  .tall video {
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: 10px;
  }
  .wide {
    grid-column: 5 / span 8;
    margin-top: clamp(4rem, 12vw, 12rem);
  }
  .wide video {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 10px;
  }
  .more-note {
    grid-column: 5 / span 5;
    margin: 0;
    color: var(--muted);
    font-size: var(--step-body);
    line-height: 1.55;
  }
  @media (max-width: 860px) {
    .cin-head .work-h,
    .cin-copy {
      grid-column: 1 / -1;
    }
    .tall {
      grid-column: 1 / span 5;
    }
    .wide {
      grid-column: 6 / -1;
      margin-top: 30%;
    }
    .more-note {
      grid-column: 1 / -1;
    }
  }
</style>
