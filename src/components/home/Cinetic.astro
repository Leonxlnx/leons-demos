---
/*
 * cinetic: films made from code. The lead film's screen opens to the full width as it scrolls in,
 * and each film's colour comes up once it holds the middle of the screen. Films play muted, only
 * while on screen, and stop with the pause button.
 */
import Icon from "../Icon.astro";
import { compact } from "../../lib/format";
import type { ViewProject } from "../../lib/projects";

interface Props {
  project: ViewProject;
}
const { project } = Astro.props;

// Screens wider than 700px play the 60fps masters untouched (H.264, faststart): Kiln and
// Ledgerly at 1920x1080, Quire at 810x1440, twice its largest size. Screens up to 700px get a
// 30fps cut of each (every second frame, H.264 CRF 23): Kiln and Ledgerly at 1280x720, Quire at
// its full 810x1440. That is 2.5, 0.86 and 0.59 MB against 3.9, 1.5 and 0.99 MB at 60fps.
// Until a film plays, a still of it stands in: its first frame, the one the video opens on, as
// AVIF at two widths and WebP for browsers without AVIF. Unlike a poster attribute it loads
// lazily, and the script asks for it a screen before the film arrives.
const film = (name: string, w: number, h: number, sm: number, sizes: string) => {
  const base = `/work/cinetic/${name}`;
  return {
    src: `${base}.mp4`,
    phone: `${base}-sm.mp4`,
    avif: `${base}-sm.avif ${sm}w, ${base}.avif ${w}w`,
    webp: `${base}.webp`,
    sizes,
    w,
    h,
  };
};
const KILN = film("kiln", 1920, 1080, 1280, "100vw");
const QUIRE = film("quire", 810, 1440, 540, "(max-width: 560px) 62vw, (max-width: 860px) 40vw, min(25vw, 24rem)");
const LEDGERLY = film("ledgerly", 1920, 1080, 1280, "(max-width: 560px) 100vw, min(66vw, 66rem)");
---

<section class="cin" aria-labelledby="cin-h">
  <div class="cin-head wrap">
    <h2 id="cin-h" class="work-h" data-reveal="line">
      <span class="line"><span>cinetic</span></span>
    </h2>
    <div class="cin-copy">
      <p class="work-p" data-reveal="up" style="--d:80ms">Launch films and motion design from code, directed by your coding agent.</p>
      <div class="work-actions" data-reveal="up" style="--d:160ms">
        <a class="button" href={project.url} target="_blank" rel="noopener">
          Repository
          <Icon name="arrow-up-right" size={16} />
        </a>
        <a class="button quiet" href={project.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <Icon name="star" size={14} />
          <span data-repo={project.repo}><span class="count">{compact(project.stars)}</span></span>
        </a>
      </div>
    </div>
  </div>

  <div class="screen-wrap">
    <figure class="screen film" data-film data-lead>
      <div class="frame">
        <video muted loop playsinline preload="none" disablepictureinpicture aria-hidden="true">
          <source src={KILN.phone} type="video/mp4" media="(max-width: 700px)" />
          <source src={KILN.src} type="video/mp4" />
        </video>
        <picture>
          <source type="image/avif" srcset={KILN.avif} sizes={KILN.sizes} />
          <img class="still" src={KILN.webp} alt="" width={KILN.w} height={KILN.h} loading="lazy" decoding="async" />
        </picture>
        <span class="shutter" aria-hidden="true"></span>
        <span class="shutter" aria-hidden="true"></span>
      </div>
      <figcaption>
        <span>Kiln</span>
        <span class="cap-note">A 25 second launch teaser, branded, scored and rendered by an agent from a <span class="nw">two-sentence</span> brief</span>
      </figcaption>
    </figure>
  </div>

  <div class="more wrap">
    <figure class="film tall" data-film data-reveal="up">
      <div class="frame">
        <video muted loop playsinline preload="none" disablepictureinpicture aria-hidden="true">
          <source src={QUIRE.phone} type="video/mp4" media="(max-width: 700px)" />
          <source src={QUIRE.src} type="video/mp4" />
        </video>
        <picture>
          <source type="image/avif" srcset={QUIRE.avif} sizes={QUIRE.sizes} />
          <img class="still" src={QUIRE.webp} alt="" width={QUIRE.w} height={QUIRE.h} loading="lazy" decoding="async" />
        </picture>
      </div>
      <figcaption><span>Quire</span><span class="cap-note">A vertical feature film</span></figcaption>
    </figure>
    <figure class="film wide" data-film data-reveal="up" style="--d:90ms">
      <div class="frame">
        <video muted loop playsinline preload="none" disablepictureinpicture aria-hidden="true">
          <source src={LEDGERLY.phone} type="video/mp4" media="(max-width: 700px)" />
          <source src={LEDGERLY.src} type="video/mp4" />
        </video>
        <picture>
          <source type="image/avif" srcset={LEDGERLY.avif} sizes={LEDGERLY.sizes} />
          <img class="still" src={LEDGERLY.webp} alt="" width={LEDGERLY.w} height={LEDGERLY.h} loading="lazy" decoding="async" />
        </picture>
      </div>
      <figcaption><span>Ledgerly</span><span class="cap-note">A feature loop</span></figcaption>
    </figure>
    <p class="more-note" data-reveal="up" style="--d:180ms">
      Every film starts as three concepts, a beat grid and a soundtrack made with earshot, then gets checked frame by
      frame before it ships.
    </p>
  </div>
</section>

<script>
  /* Films load and play only while on screen and while motion is allowed; each film keeps its
     colour only while it holds the middle of the screen. A still is asked for a screen early,
     a smaller film waits to rise in until its still is decoded, so it never arrives as an empty
     frame, and a video starts loading only once its still is in. The still gives way once the
     film has a frame of its own. */
  const films = Array.from(document.querySelectorAll<HTMLElement>("[data-film]"));
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const root = document.documentElement;
  const visible = new Set<HTMLElement>();
  const ready = new Set<HTMLElement>();
  const sync = () => {
    const paused = root.classList.contains("motion-paused");
    for (const f of films) {
      const v = f.querySelector("video")!;
      if (visible.has(f) && ready.has(f) && !paused && !reduced && !document.hidden) {
        if (v.preload === "none") v.preload = "auto";
        v.play().catch(() => {});
      } else v.pause();
    }
  };
  for (const f of films) {
    f.querySelector("video")!.addEventListener("playing", () => f.classList.add("is-live"), { once: true });
    const still = f.querySelector<HTMLImageElement>(".still")!;
    // data-wait holds the entrance (see the style); a still that fails lets the film go ahead.
    if (f.hasAttribute("data-reveal")) f.setAttribute("data-wait", "");
    const loaded = still.complete
      ? Promise.resolve()
      : new Promise((done) => {
          still.addEventListener("load", done, { once: true });
          still.addEventListener("error", done, { once: true });
        });
    loaded
      .then(() => still.decode())
      .catch(() => {})
      .then(() => {
        ready.add(f);
        f.removeAttribute("data-wait");
        sync();
      });
  }
  if ("IntersectionObserver" in window) {
    const early = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.querySelector<HTMLImageElement>(".still")!.loading = "eager";
          early.unobserve(e.target);
        }
      },
      { rootMargin: "100% 0px" },
    );
    films.forEach((f) => early.observe(f));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const f = e.target as HTMLElement;
          if (e.isIntersecting) visible.add(f);
          else visible.delete(f);
        }
        sync();
      },
      { threshold: 0.25 },
    );
    films.forEach((f) => io.observe(f));
    const lit = new IntersectionObserver(
      (entries) => {
        for (const e of entries) (e.target as HTMLElement).classList.toggle("is-lit", e.isIntersecting);
      },
      { rootMargin: "-30% 0px -30% 0px" },
    );
    films.forEach((f) => lit.observe(f));
  }
  document.addEventListener("visibilitychange", sync);
  new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["class"] });
</script>

<style>
  .cin {
    padding-top: var(--section);
  }
  .cin-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2rem;
    align-items: end;
  }
  .cin-head .work-h {
    grid-column: 1 / span 6;
  }
  .cin-copy {
    grid-column: 8 / -1;
  }

  .film {
    position: relative;
    margin: 0;
  }
  /* The frame holds the film and its still under a grey veil, a saturation blend that takes the
     colour out. The veil fades away when the film is lit, so only its opacity animates, and
     once gone it leaves nothing to blend over the playing film. The fade runs on
     the plain ease-out curve, so the colour visibly comes up over its quarter second instead of
     arriving in the first frames as it does on the steep --ease-out. */
  .frame {
    position: relative;
    overflow: hidden;
    background: #111;
    isolation: isolate;
  }
  .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #808080;
    mix-blend-mode: saturation;
    pointer-events: none;
    transition:
      opacity var(--t-ui) ease-out,
      visibility var(--t-ui);
  }
  .frame video,
  .frame picture,
  .still {
    display: block;
    width: 100%;
    height: 100%;
  }
  .frame video {
    object-fit: cover;
  }
  .frame picture {
    position: absolute;
    inset: 0;
  }
  .still {
    object-fit: cover;
    transition: opacity var(--t-ui) var(--ease-out);
  }
  .film:global(.is-live) .still {
    opacity: 0;
  }
  .film:global(.is-lit) .frame::after {
    opacity: 0;
    visibility: hidden;
  }
  /* A smaller film stays down in its entrance until its still is decoded (data-wait, set by the
     script), then rises in on the reveal's own transition. */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.reveal) .film[data-wait] {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .film figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 0.9rem;
    font-size: var(--step-body);
    line-height: 1.4;
  }
  .cap-note {
    color: var(--muted);
    text-wrap: pretty;
  }
  .nw {
    white-space: nowrap;
  }

  /* The lead screen opens from a framed picture to the full width as it scrolls in: two shutters
     in the page's colour, with the picture's rounded corners cut into their inner edges, slide
     out to the sides. Only their transforms move, so the opening runs on the compositor. Where
     scroll-driven animations or motion are off, they are not drawn and the film is full width. */
  .screen-wrap {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .screen .frame {
    aspect-ratio: 16 / 9;
  }
  /* The lead's colour comes up slowly, as the full-width film settles in the middle. */
  .screen .frame::after {
    transition-duration: 700ms;
  }
  .screen figcaption {
    padding-inline: var(--pad);
  }
  .screen .cap-note {
    max-width: 44ch;
  }
  .shutter {
    display: none;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .screen {
        view-timeline: --screen block;
        animation: screen-lift linear both;
        animation-timeline: --screen;
        animation-range: entry 0% cover 45%;
      }
      .shutter {
        --r: 14px;
        position: absolute;
        top: 0;
        bottom: 0;
        z-index: 1;
        display: block;
        width: calc(18% + var(--r));
        animation: shutter-left linear backwards;
        animation-timeline: --screen;
        animation-range: entry 0% cover 45%;
        transform: translateX(-100%);
      }
      .shutter:first-of-type {
        left: 0;
        background:
          radial-gradient(circle at 100% 100%, transparent calc(var(--r) - 0.5px), var(--bg) var(--r)) right top / var(--r) var(--r) no-repeat,
          radial-gradient(circle at 100% 0, transparent calc(var(--r) - 0.5px), var(--bg) var(--r)) right bottom / var(--r) var(--r) no-repeat,
          linear-gradient(var(--bg), var(--bg)) left / calc(100% - var(--r)) 100% no-repeat;
      }
      .shutter:last-of-type {
        right: 0;
        background:
          radial-gradient(circle at 0 100%, transparent calc(var(--r) - 0.5px), var(--bg) var(--r)) left top / var(--r) var(--r) no-repeat,
          radial-gradient(circle at 0 0, transparent calc(var(--r) - 0.5px), var(--bg) var(--r)) left bottom / var(--r) var(--r) no-repeat,
          linear-gradient(var(--bg), var(--bg)) right / calc(100% - var(--r)) 100% no-repeat;
        animation-name: shutter-right;
        transform: translateX(100%);
      }
    }
  }
  @keyframes screen-lift {
    from {
      transform: translateY(4rem);
    }
    to {
      transform: none;
    }
  }
  @keyframes shutter-left {
    from {
      transform: none;
    }
    to {
      transform: translateX(-100%);
    }
  }
  @keyframes shutter-right {
    from {
      transform: none;
    }
    to {
      transform: translateX(100%);
    }
  }

  .more {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2.5rem;
    align-items: start;
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .tall {
    grid-column: 1 / span 3;
  }
  .tall .frame {
    aspect-ratio: 9 / 16;
    border-radius: 10px;
  }
  .wide {
    grid-column: 5 / span 8;
    margin-top: clamp(4rem, 12vw, 12rem);
  }
  .wide .frame {
    aspect-ratio: 16 / 9;
    border-radius: 10px;
  }
  .more-note {
    grid-column: 5 / span 5;
    margin: 0;
    color: var(--muted);
    font-size: var(--step-body);
    line-height: 1.55;
  }
  @media (max-width: 860px) {
    .cin-head .work-h,
    .cin-copy {
      grid-column: 1 / -1;
    }
    .tall {
      grid-column: 1 / span 5;
    }
    .wide {
      grid-column: 6 / -1;
      margin-top: 30%;
    }
    .more-note {
      grid-column: 1 / -1;
    }
  }
  /* On a phone the two films stack, each large enough to read. */
  @media (max-width: 560px) {
    .tall {
      grid-column: 1 / span 8;
    }
    .wide {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }
</style>
