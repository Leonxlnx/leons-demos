---
/*
 * Taste Skill, the main work: what it is, the install command (types itself), the two live
 * figures as odometers, and a band of pages agents built with it that slides with the scroll.
 */
import Icon from "../Icon.astro";
import { compact } from "../../lib/format";
import { column, glyphs } from "../../lib/odometer";
import type { ViewProject } from "../../lib/projects";

interface Props {
  taste: ViewProject;
  installs: number;
}
const { taste, installs } = Astro.props;
const INSTALL = "npx skills add Leonxlnx/taste-skill";

// The pages, captured at 2x from the examples in the repository: AVIF at 800 and 1600 wide, and
// WebP for browsers without AVIF.
const OUTPUTS = [
  { name: "taste-nachtschicht", alt: "A club night website built with Taste Skill: a grid of archival photographs and black date tiles" },
  { name: "taste-roast", alt: "A coffee roaster's page built with Taste Skill: four photographs of beans from raw to cooled" },
  { name: "taste-storefront", alt: "A coffee shop storefront page built with Taste Skill" },
  { name: "taste-questions", alt: "A questions page for a coffee shop built with Taste Skill" },
];
---

<section class="taste paper" aria-labelledby="taste-h">
  <div class="wrap grid12 taste-head">
    <h2 id="taste-h" class="taste-h drift" data-reveal="line">
      <span class="line"><span>Taste Skill</span></span>
    </h2>
    <div class="taste-copy">
      <p data-reveal="up" style="--d:70ms">
        A rulebook coding agents read before they write frontend, so what they build stops looking generated. Works with
        Claude Code, Codex, Cursor, Gemini CLI and more.
      </p>
    </div>
  </div>

  <div class="wrap grid12 specimens" data-odo>
    {
      [
        { value: taste.stars, caption: "GitHub stars", delay: 0, repo: taste.repo },
        { value: installs, caption: "Installs on skills.sh", delay: 120 },
      ].map((f) => (
        <figure class="specimen" style={`--fd:${f.delay}ms`}>
          <div class="cut">
            <p class="figure" data-repo={f.repo}>
              <span class="glyphs" aria-hidden="true">
                {glyphs(compact(f.value)).map((g) =>
                  "digit" in g ? (
                    <span class="odo" style={`--o:${g.order}; --col:"${column(g.digit!).col}"`}>
                      {g.digit}
                    </span>
                  ) : (
                    <span class="unit">
                      <span>{g.unit}</span>
                    </span>
                  ),
                )}
              </span>
              <span class="sr-only">{f.value.toLocaleString("en-US")}</span>
            </p>
          </div>
          <figcaption>{f.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <div class="wrap install-row">
    <div class="install" data-reveal="fade" style="--d:80ms">
      <span class="typed" style={`--chars:${INSTALL.length}`}>
        <code>{INSTALL}</code>
        <span class="caret" aria-hidden="true"></span>
      </span>
      <button class="copy" type="button" data-copy={INSTALL}>
        <span class="glyph" aria-hidden="true">
          <Icon name="copy" size={18} />
          <Icon name="check" size={18} />
        </span>
        <span class="roll sr-only">
          <span>Copy</span>
          <span aria-hidden="true">Copied</span>
        </span>
      </button>
      <span class="sr-only" role="status" aria-live="polite"></span>
    </div>
    <p class="taste-links" data-reveal="up" style="--d:160ms">
      <a class="ink" href="https://www.tasteskill.dev" target="_blank" rel="noopener">tasteskill.dev</a>
      <a class="ink" href={taste.url} target="_blank" rel="noopener">Repository</a>
    </p>
  </div>

  <div class="outputs" data-outputs>
    <ul class="band" aria-label="Pages built with Taste Skill">
      {
        OUTPUTS.map((o, i) => (
          <li class="shot" style={`--d:${i * 90}ms`}>
            <picture>
              <source type="image/avif" srcset={`/work/${o.name}-sm.avif 800w, /work/${o.name}.avif 1600w`} sizes="clamp(18rem, 42vw, 46rem)" />
              <img src={`/work/${o.name}.webp`} alt={o.alt} width="1600" height="928" loading="lazy" decoding="async" data-reveal="up" />
            </picture>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  /* A copy that fails (no clipboard access) must not show the check. The page script still marks
     the button done, with its hidden label set to "Select and copy", so here the glyph stays the
     copy glyph and the command is selected instead, ready to copy by hand. */
  for (const b of document.querySelectorAll<HTMLButtonElement>(".install [data-copy]")) {
    const label = b.querySelector(".roll > span + span");
    const code = b.closest(".install")?.querySelector("code");
    new MutationObserver(() => {
      const failed = b.classList.contains("is-done") && label?.textContent !== "Copied";
      b.toggleAttribute("data-failed", failed);
      if (failed && code) getSelection()?.selectAllChildren(code);
    }).observe(b, { attributes: true, attributeFilter: ["class"] });
  }
</script>

<style>
  /* The seam above it ends in solid paper and supplies the transition space, so the section
     itself starts close to its heading. */
  .taste {
    padding-top: var(--section);
    padding-bottom: var(--section);
    overflow: hidden;
    overflow: clip;
  }
  .taste-head {
    row-gap: 2rem;
    align-items: end;
  }
  .taste-h {
    grid-column: 1 / span 7;
    margin: 0;
    font-size: var(--step-section);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .taste-copy {
    grid-column: 8 / -1;
    padding-bottom: 0.4rem;
  }
  .taste-copy > p:first-child {
    margin: 0;
    max-width: 30ch;
    font-size: var(--step-lead);
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .install-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  /* One row: the command, then the copy button. */
  .install {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.375rem 0.375rem 0.375rem 1.25rem;
    border-radius: 999px;
    background: var(--paper-2);
  }
  .typed {
    position: relative;
    display: inline-block;
  }
  /* Literal terminal text, the one place the page sets monospace. */
  .install code {
    font-family: var(--mono);
    font-size: 0.9375rem;
    letter-spacing: 0;
    white-space: nowrap;
    user-select: all;
  }
  .caret {
    display: none;
  }
  /* A circle with a copy glyph that turns into a check once the command is on the clipboard.
     Its label stays for screen readers, and the status line beside it speaks the result. */
  .copy {
    display: none;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--paper-ink);
    color: var(--paper);
    transition: transform var(--t-press) var(--ease-out);
  }
  .copy:active {
    transform: scale(0.94);
  }
  .copy:focus-visible {
    background: #333;
  }
  /* Only once the page script runs, which is what makes it work. */
  :global(.reveal) .copy {
    display: grid;
  }
  .glyph {
    display: grid;
  }
  .glyph :global(.icon) {
    grid-area: 1 / 1;
    transition:
      opacity var(--t-ui) var(--ease-out),
      transform var(--t-ui) var(--ease-out);
  }
  .glyph :global(.icon + .icon),
  .copy.is-done:not([data-failed]) .glyph :global(.icon:first-child) {
    opacity: 0;
    transform: scale(0.6);
  }
  .copy.is-done:not([data-failed]) .glyph :global(.icon + .icon) {
    opacity: 1;
    transform: none;
  }
  .taste-links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    font-size: var(--step-body);
  }
  .taste-links a {
    padding-block: 0.6rem;
    margin-block: -0.6rem;
  }

  /* The figures stand on the heading's columns, the second on the copy's left edge, each with its
     caption under it. They share one size, set by the narrower right column: --fig resolves
     against the row (the .specimens container), and 17.5% of it is a little under half of five
     columns, so the wider figure keeps clear of the right edge. */
  .specimens {
    margin-top: clamp(5rem, 12svh, 9rem);
    container-type: inline-size;
  }
  .specimen {
    --fig: min(var(--step-monument), 17.5cqi);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0;
  }
  .specimen:first-child {
    grid-column: 1 / span 7;
  }
  .specimen:last-child {
    grid-column: 8 / -1;
  }
  .specimen figcaption {
    color: var(--paper-muted);
    font-size: var(--step-body);
    line-height: 1.35;
  }
  /* Ends on the figures' baseline. Only the bottom is cut: the left side bearing stays whole. */
  .cut {
    height: calc(var(--fig) * 0.762);
    overflow: hidden;
    overflow: visible clip;
  }
  @supports (height: 1lh) {
    .cut {
      font-size: var(--fig);
      line-height: 0.8;
      height: calc(0.5lh + 0.362em);
    }
  }
  .figure {
    margin: 0 0 0 -0.06em;
    font-size: var(--fig);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.06em;
    white-space: nowrap;
  }
  .glyphs {
    user-select: none;
  }
  /* Odometer: the text is the real figure (95K). When it rolls, each digit's glyph is hidden
     behind a generated column 0-9 then 0..n, which travels up and parks on the same digit, so
     the page text, crawlers and reader views only ever see the figure. */
  .figure .odo,
  .figure .unit {
    position: relative;
    display: inline-block;
    height: 0.8em;
    height: 1lh;
    overflow: clip;
    vertical-align: top;
  }
  .figure .unit > span {
    display: block;
  }

  /* The band of pages: it travels left while the section crosses the screen. */
  .outputs {
    margin-top: clamp(4rem, 8vw, 7.5rem);
  }
  .band {
    display: flex;
    gap: clamp(0.75rem, 1.4vw, 1.5rem);
    width: max-content;
    margin: 0;
    padding: 0 var(--pad);
    list-style: none;
  }
  .shot {
    flex: none;
    width: clamp(18rem, 42vw, 46rem);
  }
  /* In greyscale like the rest of the page, with a hairline, so a page as light as the paper
     keeps its edge. */
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-media);
    background: var(--paper-2);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06);
    filter: grayscale(1);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .band {
        animation: band-travel linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }
  @keyframes band-travel {
    from {
      transform: translateX(8vw);
    }
    to {
      transform: translateX(calc(100vw - 100% - 8vw));
    }
  }
  /* Without scroll timelines the band scrolls by hand. */
  @supports not (animation-timeline: view()) {
    .outputs {
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
  /* With reduced motion the band stays still, so the pages lie in a grid on the column instead,
     two to a row and one on a phone, every one of them in reach. */
  @media (prefers-reduced-motion: reduce) {
    .band {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: auto;
      max-width: 1680px;
      margin-inline: auto;
    }
    .shot {
      width: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) and (max-width: 560px) {
    .band {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    /* The install command types itself, one character every 28ms, behind a block caret that
       blinks twice and leaves. It is one text node, selectable and copyable throughout. The
       caret is as wide as the line, its block painted at the left edge, so travelling the line
       is a translate of 100% that the compositor runs. */
    :global(.reveal) .install:not(.is-in) code {
      clip-path: inset(0 100% 0 0);
    }
    :global(.reveal) .install.is-in code {
      animation: type calc(var(--chars) * 28ms) steps(var(--chars), jump-end) 420ms backwards;
    }
    :global(.reveal) .install.is-in .caret {
      position: absolute;
      top: 0.12em;
      bottom: 0.08em;
      left: 0;
      display: block;
      width: 100%;
      background: linear-gradient(currentColor, currentColor) 0 0 / 0.55em 100% no-repeat;
      pointer-events: none;
      animation:
        caret-move calc(var(--chars) * 28ms) steps(var(--chars), jump-end) 420ms both,
        caret-end 1140ms steps(1, jump-end) calc(420ms + var(--chars) * 28ms) forwards;
    }

    /* Odometer: digits roll right to left; the units rise out of the section's floor. A live
       count that arrives after the roll (home.ts) rewinds only the changed glyphs. */
    :global(.reveal) [data-odo] .figure .odo {
      color: transparent;
    }
    :global(.reveal) [data-odo] .figure .odo::before {
      content: var(--col);
      position: absolute;
      top: 0;
      left: 0;
      color: var(--paper-ink);
      line-height: inherit;
      white-space: pre;
      transform: translateY(calc(var(--rows, 3) * -1lh));
    }
    :global(.reveal) [data-odo]:not(.is-in) .figure .odo::before,
    :global(.reveal) [data-odo] .figure .odo.rewind::before {
      transform: none;
    }
    :global(.reveal) [data-odo].is-in .figure .odo::before {
      transition: transform 800ms var(--ease-out) calc(var(--fd, 0ms) + var(--o, 0) * var(--stagger));
    }
    :global(.reveal) [data-odo]:not(.is-in) .figure .unit > span,
    :global(.reveal) [data-odo] .figure .unit.rewind > span {
      transform: translateY(100%);
    }
    :global(.reveal) [data-odo] .figure .rewind > span,
    :global(.reveal) [data-odo] .figure .rewind::before {
      transition: none !important;
    }
    :global(.reveal) [data-odo].is-in .figure .unit > span {
      transition: transform 900ms var(--ease-out) var(--fd, 0ms);
    }
  }
  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes caret-move {
    from {
      translate: 0;
    }
    to {
      translate: 100%;
    }
  }
  @keyframes caret-end {
    0% {
      opacity: 1;
    }
    44% {
      opacity: 0;
    }
    66% {
      opacity: 1;
    }
    88%,
    100% {
      opacity: 0;
    }
  }

  /* On a phone the capsule fills the column, command at the left and the circle at the right.
     The command steps down only as far as it must to stay on one line: 0.61em is a little over
     the advance of the monospace faces in the stack, and 4.75rem the capsule's padding, gap and
     circle with some room to spare. */
  @media (max-width: 480px) {
    .install {
      width: 100%;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.25rem 0.25rem 0.25rem 1rem;
    }
    .install code {
      font-size: min(0.9375rem, (100vw - 2 * var(--pad) - 4.75rem) / (var(--chars) * 0.61));
    }
  }
  @media (max-width: 860px) {
    .taste {
      padding-bottom: calc(var(--section) * 0.5);
    }
    .taste-h,
    .taste-copy {
      grid-column: 1 / -1;
    }
    .taste-h {
      font-size: calc((100vw - 2 * var(--pad)) / 5.3);
    }
    .specimens {
      margin-top: 4rem;
    }
    /* Half the row each; a figure is 40% of its half. */
    .specimen:first-child,
    .specimen:last-child {
      grid-column: span 6;
    }
    .specimen {
      --fig: min(19rem, 20cqi - 0.2 * var(--gutter));
    }
    .cut {
      height: auto;
      overflow: visible;
    }
  }
</style>
