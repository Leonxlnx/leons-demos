---
interface Props {
  path: string;
}
const { path } = Astro.props;
const links = [
  { href: "/demos", label: "Demos" },
  { href: "https://github.com/Leonxlnx", label: "GitHub", name: "GitHub (Leonxlnx)" },
  { href: "https://x.com/LexnLin", label: "X", name: "X (@LexnLin)" },
];
---

<nav class="nav" aria-label="Main">
  {
    links.map((l) =>
      l.href.startsWith("/") ? (
        <a href={l.href} aria-current={l.href === path ? "page" : undefined}>
          {l.label}
        </a>
      ) : (
        <a href={l.href} target="_blank" rel="noopener" aria-label={l.name}>
          {l.label}
        </a>
      ),
    )
  }
</nav>
