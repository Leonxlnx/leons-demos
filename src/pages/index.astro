---
import previews from "../../data/previews.json";
import Icon from "../components/Icon.astro";
import Nav from "../components/Nav.astro";
import Base from "../layouts/Base.astro";
import { DEMOS, compact, sizedImage, type ViewDemo } from "../lib/demos";
import { PROJECTS } from "../lib/projects";

const EMAIL = "lexn.lin@gmail.com";
const TASTE_INSTALL = "npx skills add Leonxlnx/taste-skill";
/** Total installs across the Taste Skill skills, from skills.sh (13 October 2026). Update by hand. */
const TASTE_INSTALLS = 5_200_000;

// Demos whose first video frame is black, blank or blurred. They stay on /demos.
const WEAK_POSTERS = new Set([
  "2104148233106723099",
  "2103194052850241739",
  "2103069626473341273",
  "2091550626421338325",
  "2081438372447350957",
]);
// White-ground posters, which vanish into the light closing section.
const LIGHT_POSTERS = new Set(["2106101651010449796"]);

/** Pixel size of a demo's video, read from the twimg URL (".../vid/avc1/1440x900/..."). */
const size = (d: ViewDemo) => {
  const m = d.video?.match(/\/(\d{3,4})x(\d{3,4})\//);
  return m ? { w: Number(m[1]), h: Number(m[2]) } : { w: 1600, h: 900 };
};
const ratio = (d: ViewDemo) => size(d).w / size(d).h;

/** twimg fits posters inside a square box, so a portrait poster is narrower than the box. */
const posterSrcset = (d: ViewDemo) => {
  const r = ratio(d);
  const width = (box: number) => Math.min(Math.round(r >= 1 ? box : box * r), size(d).w);
  return `${sizedImage(d.poster!, "small")} ${width(680)}w, ${sizedImage(d.poster!, "medium")} ${width(1200)}w`;
};

/** Smaller encodes for the strip (data/previews.json); falls back to the full video. */
const preview = (d: ViewDemo) => (previews as Record<string, { sd: string; hd: string }>)[d.video?.match(/_video\/(\d+)\//)?.[1] ?? ""];

// The hero strip holds every demo with a usable video, most liked in the middle and the
// rest alternating right and left of it, so the first screen shows the strongest work.
const reel = DEMOS.filter((d) => d.video && d.poster && !WEAK_POSTERS.has(d.id));
const strip: ViewDemo[] = [];
reel.forEach((d, i) => (i % 2 ? strip.push(d) : strip.unshift(d)));
const rank = new Map(reel.map((d, i) => [d, i]));
const FRAME_H = 425;

const taste = PROJECTS.find((p) => p.name === "taste-skill");
// The open-source index, in this order. Every other repo stays on GitHub.
const SHOWN = ["tastecode", "unlazy", "cinetic", "kimi-code-desktop", "lumenshaders", "todobar", "prompt-library"];
const projects = SHOWN.map((name) => PROJECTS.find((p) => p.name === name)).filter((p) => p !== undefined);

interface Row {
  what: string;
  url?: string;
  result: string;
  lang?: string;
}
const recognition: { group: string; rows: Row[] }[] = [
  {
    group: "Taste Skill",
    rows: [
      { what: "Vercel Open Source Program", url: "https://vercel.com/blog/vercel-open-source-program-spring-2026-cohort", result: "Spring 2026 cohort" },
      { what: "Google Labs Stitch Skills", url: "https://github.com/google-labs-code/stitch-skills/pull/38", result: "taste-design merged" },
    ],
  },
  {
    group: "Competitions",
    rows: [
      { what: "LovHack Season 1", result: "2nd place" },
      { what: "Landeswettbewerb Mathematik Bayern", result: "Landessieger", lang: "de" },
      { what: "European Statistics Competition", result: "4th in national round 2, qualified for Europe" },
      { what: "Pangea Mathematics Final 2024", result: "Gold" },
    ],
  },
];

// Rows alternate a fill across the whole table, not per group.
let row = 0;
const groups = recognition.map((g) => ({ ...g, rows: g.rows.map((r) => ({ ...r, alt: row++ % 2 === 0 })) }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Leon Lin",
  url: "https://leonlin.de",
  email: `mailto:${EMAIL}`,
  address: { "@type": "PostalAddress", addressLocality: "Munich", addressCountry: "DE" },
  sameAs: ["https://x.com/LexnLin", "https://github.com/Leonxlnx", "https://www.tasteskill.dev"],
};
---

<Base
  title="Leon Lin"
  description="I build tools that give AI good taste. Creator of Taste Skill, high school student in Munich."
  twimg
  header={false}
  jsonLd={jsonLd}
>
  <main>
    <section class="hero" aria-labelledby="name">
      <div class="hero-top wrap">
        <h1 id="name" class="name"><span class="line"><span>Leon Lin</span></span></h1>
        <Nav path="/" />
      </div>

      <div class="strip-wrap">
        <ul class="strip" aria-label="Demos, most liked in the middle">
          {
            strip.map((d) => {
              const r = ratio(d);
              const p = preview(d);
              return (
                <li class="frame" style={`--r:${r.toFixed(4)}`} data-start={rank.get(d) === 0 ? "" : undefined}>
                  <a href={d.post_url} target="_blank" rel="noopener" aria-label={`${d.shortTitle}, ${compact(d.likes)} likes`}>
                    <img
                      src={sizedImage(d.poster!, "small")}
                      srcset={posterSrcset(d)}
                      sizes={`(max-width: 700px) calc(${r.toFixed(3)} * 56vw), calc(${r.toFixed(3)} * min(42vh, 30rem))`}
                      alt=""
                      width={Math.round(FRAME_H * r)}
                      height={FRAME_H}
                      loading={rank.get(d)! < 6 ? "eager" : "lazy"}
                      fetchpriority={rank.get(d) === 0 ? "high" : "auto"}
                      decoding="async"
                    />
                    <video
                      data-src={d.video}
                      data-sd={p?.sd}
                      data-hd={p?.hd}
                      muted
                      loop
                      playsinline
                      preload="none"
                      aria-hidden="true"
                    />
                  </a>
                  <p class="cap" aria-hidden="true">
                    <span class="cap-title">{d.shortTitle}</span>
                    <span class="cap-likes"><Icon name="heart" size={12} />{compact(d.likes)}</span>
                  </p>
                </li>
              );
            })
          }
        </ul>
        <script is:inline>
          (function () {
            var s = document.currentScript.previousElementSibling;
            var f = s.querySelector("[data-start]");
            s.setAttribute("data-ready", "");
            if (f) s.scrollLeft = f.offsetLeft + f.offsetWidth / 2 - s.clientWidth / 2;
          })();
        </script>
        <button class="motion" type="button" aria-pressed="false" hidden>
          <Icon name="pause" size={14} />
          <span class="sr-only">Pause clips and moving pictures</span>
        </button>
      </div>

      <div class="hero-foot wrap">
        <p class="lede" style="--i:0">
          I build tools that give AI good taste<br /><span>Creator of Taste Skill, high school student in Munich</span>
        </p>
        <a class="button" style="--i:1" href={`mailto:${EMAIL}`}>Email me</a>
      </div>
    </section>

    {
      taste && (
        <section class="taste paper" aria-labelledby="taste-h">
          <div class="wrap grid12 taste-head">
            <h2 id="taste-h" class="h2" data-reveal style="--i:0">
              Taste Skill
            </h2>
            <div class="taste-copy">
              <p data-reveal style="--i:1">
                A rulebook coding agents read before they write frontend, so what they build stops looking generated.
                Works with Claude Code, Codex, Cursor, Gemini CLI and more.
              </p>
              <div class="install" data-reveal style="--i:2">
                <code>{TASTE_INSTALL}</code>
                <button class="copy" type="button" data-copy={TASTE_INSTALL}>
                  Copy
                </button>
                <span class="sr-only" role="status" aria-live="polite" />
              </div>
              <p class="taste-links" data-reveal style="--i:3">
                <a href="https://www.tasteskill.dev" target="_blank" rel="noopener">
                  tasteskill.dev
                </a>
                <a href={taste.url} target="_blank" rel="noopener">
                  Repository
                </a>
              </p>
            </div>
          </div>
          <div class="wrap grid12 specimens" data-reveal-group>
            <figure class="specimen">
              <div class="cut">
                <p class="figure">
                  <span aria-hidden="true" data-count={taste.stars}>{compact(taste.stars)}</span>
                  <span class="sr-only">{taste.stars.toLocaleString("en-US")}</span>
                </p>
              </div>
              <figcaption>GitHub stars</figcaption>
            </figure>
            <figure class="specimen">
              <div class="cut">
                <p class="figure" style="--i:1">
                  <span aria-hidden="true" data-count={TASTE_INSTALLS}>{compact(TASTE_INSTALLS)}</span>
                  <span class="sr-only">{TASTE_INSTALLS.toLocaleString("en-US")}</span>
                </p>
              </div>
              <figcaption>Installs on skills.sh</figcaption>
            </figure>
          </div>
        </section>
      )
    }

    <section class="oss wrap" aria-labelledby="oss-h">
      <h2 id="oss-h" class="h2" data-reveal>Open source</h2>
      <ul class="index">
        {
          projects.map((p, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a class="entry" href={p.url} target="_blank" rel="noopener">
                <span class="entry-name">{p.name}</span>
                <span class="entry-note">{p.note}</span>
                <span class="entry-stars">
                  <Icon name="star" size={14} />
                  {compact(p.stars)}
                  <span class="sr-only">stars</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="recog wrap" aria-labelledby="recog-h">
      <h2 id="recog-h" class="h2" data-reveal>Recognition</h2>
      <table class="table" aria-labelledby="recog-h">
        {
          groups.map((g) => (
            <tbody>
              {g.rows.map((r, i) => (
                <tr class:list={[r.alt && "alt"]} data-reveal style={`--i:${i}`}>
                  <td class:list={["grp", i === 0 && "first"]}>
                    <span class:list={[i > 0 && "sr-only"]}>{g.group}</span>
                  </td>
                  <th scope="row">
                    {r.url ? (
                      <a href={r.url} target="_blank" rel="noopener">
                        {r.what}
                      </a>
                    ) : (
                      r.what
                    )}
                  </th>
                  <td class="res" lang={r.lang}>
                    {r.result}
                  </td>
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </section>
  </main>

  <footer class="close paper" aria-labelledby="close-h">
    <div class="reel" aria-hidden="true">
      <div class="reel-track">
        {
          [0, 1].map(() =>
            reel
              .filter((d) => !LIGHT_POSTERS.has(d.id))
              .slice(0, 14)
              .map((d) => (
                <img
                  src={sizedImage(d.poster!, "small")}
                  srcset={`${d.poster!.replace(/\?.*$/, "")}?format=webp&name=360x360 360w, ${sizedImage(d.poster!, "small")} 680w`}
                  sizes={`${Math.round(150 * ratio(d))}px`}
                  alt=""
                  width={Math.round(150 * ratio(d))}
                  height="150"
                  loading="lazy"
                  decoding="async"
                />
              )),
          )
        }
      </div>
    </div>
    <div class="wrap">
      <h2 id="close-h" class="email" data-reveal>
        <a href={`mailto:${EMAIL}`} aria-label={EMAIL}>lexn.lin@<span>gmail.com</span></a>
      </h2>
      <ul class="cells">
        <li data-reveal style="--i:1">
          <a href="https://x.com/LexnLin" target="_blank" rel="noopener">@LexnLin on X</a>
        </li>
        <li data-reveal style="--i:2">
          <a href="https://github.com/Leonxlnx" target="_blank" rel="noopener">Leonxlnx on GitHub</a>
        </li>
      </ul>
      <p class="fine">Munich, Germany</p>
    </div>
  </footer>

  <script>
    import "../scripts/home";
  </script>
</Base>

<style>
  .wrap {
    width: 100%;
    max-width: 1680px;
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .grid12 {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  main {
    --section: clamp(5rem, 11vw, 11rem);
  }
  .h2 {
    grid-column: 1 / span 5;
    margin: 0;
    font-size: var(--step-lead);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .paper {
    background: var(--paper);
    color: var(--paper-ink);
    color-scheme: light;
  }
  .paper :focus-visible {
    outline-color: var(--paper-ink);
  }
  .paper ::selection {
    background: var(--paper-ink);
    color: var(--paper);
  }

  /* ------------------------------------------------------------ hero */

  .hero {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3.5svh, 2.5rem);
    min-height: 100svh;
    padding-block: clamp(1.25rem, 3vw, 2rem);
  }
  .hero-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .name {
    margin: 0 0 0 -0.045em;
    font-size: var(--step-display);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.055em;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em;
    margin-block: -0.06em;
  }
  .line > span {
    display: block;
  }
  .hero-top :global(.nav) {
    padding-top: 0.25rem;
  }

  .strip-wrap {
    position: relative;
    min-height: calc(var(--h) + 2.75rem);
    margin-block: auto;
    --h: clamp(13.75rem, 42vh, 30rem);
  }
  @supports (height: 1svh) {
    .strip-wrap {
      --h: clamp(13.75rem, 42svh, 30rem);
    }
  }
  .strip {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0;
    padding: 0 calc(50% - 12rem) 2.75rem;
    list-style: none;
    overflow: auto hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  /* Kept out of layout until the inline script has centred it, so nothing lazy-loads at the wrong end. */
  :global(.js) .strip:not([data-ready]) {
    display: none;
  }
  .strip.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }
  .frame {
    position: relative;
    flex: none;
    width: calc(var(--h) * var(--r));
    scroll-snap-align: center;
  }
  .frame a {
    position: relative;
    display: block;
    height: var(--h);
    overflow: hidden;
    background: var(--surface);
  }
  .frame a:focus-visible {
    outline: none;
  }
  /* The focus ring sits inside the frame, where the scroller cannot clip it. */
  .frame a:focus-visible::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border: 3px solid #fff;
    outline: 2px solid #000;
    outline-offset: -5px;
  }
  .frame img,
  .frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame video {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .frame.playing video {
    opacity: 1;
  }
  .cap {
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    margin: 0.75rem 0 0;
    font-size: var(--step-body);
    line-height: 1.4;
    white-space: nowrap;
  }
  .cap-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cap-likes {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .strip.is-live {
    cursor: grab;
  }
  .is-live .frame a {
    filter: brightness(0.42);
    transition: filter 0.6s var(--ease);
  }
  .is-live .frame.is-lit a,
  .is-live .frame a:focus-visible {
    filter: none;
  }
  .is-live .cap {
    position: absolute;
    top: var(--h);
    left: 0;
    width: max(100%, 24rem);
    max-width: calc(100vw - 2 * var(--pad) - 3.5rem);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .is-live .frame.is-lit .cap {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .is-live .frame:not(.is-lit) a:hover {
      filter: brightness(0.7);
    }
  }

  /* The lens: a frame grows and brightens as it reaches the middle of the strip, and its
     picture drifts against the drag. Tied to the scroll position, so it follows the hand. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .is-live .frame a {
        animation: lens linear both;
        animation-timeline: view(inline);
        animation-range: cover calc(50% - min(34vw, 30rem)) cover calc(50% + min(34vw, 30rem));
      }
      .is-live .frame img,
      .is-live .frame video {
        scale: 1.12;
        animation: drift linear both;
        animation-timeline: view(inline);
      }
    }
  }
  @keyframes lens {
    0%,
    100% {
      transform: scale(0.86);
      filter: brightness(0.4);
    }
    50% {
      transform: none;
      filter: none;
    }
  }
  @keyframes drift {
    from {
      translate: 5% 0;
    }
    to {
      translate: -5% 0;
    }
  }

  .motion {
    position: absolute;
    top: calc(var(--h) + 0.35rem);
    right: var(--pad);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    transition:
      transform var(--t-press) var(--ease),
      background-color var(--t-hover) ease;
  }
  .motion[hidden] {
    display: none;
  }
  .motion:active {
    transform: scale(0.94);
  }
  @media (hover: hover) and (pointer: fine) {
    .motion:hover {
      background: #262626;
    }
  }
  .hero-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .lede {
    margin: 0;
    max-width: 32ch;
    font-size: var(--step-lead);
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .lede span {
    display: block;
    color: var(--muted);
  }
  .button,
  .copy,
  .cells a {
    transition:
      transform var(--t-press) var(--ease),
      background-color var(--t-hover) ease,
      color var(--t-hover) ease;
  }
  .button:active,
  .copy:active,
  .cells a:active {
    transform: scale(0.97);
  }
  .button {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-size: var(--step-body);
    font-weight: 500;
  }
  @media (hover: hover) and (pointer: fine) {
    .button:hover {
      background: #d4d4d4;
    }
  }

  /* ------------------------------------------------------------ taste skill */

  .taste {
    margin-top: var(--section);
    padding-top: var(--section);
    overflow: hidden;
  }
  .taste-head {
    row-gap: 1.5rem;
  }
  .taste-copy {
    grid-column: 7 / -1;
  }
  .taste-copy > p:first-child {
    margin: 0;
    max-width: 30ch;
    font-size: var(--step-lead);
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .install {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1.75rem;
    padding: 0.375rem 0.375rem 0.375rem 1.25rem;
    border-radius: 999px;
    background: var(--paper-2);
  }
  .install code {
    font: inherit;
    font-size: var(--step-body);
    user-select: all;
  }
  .copy {
    display: none;
    min-height: 2.5rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--paper-ink);
    color: var(--paper);
    font-size: var(--step-body);
    font-weight: 500;
  }
  :global(.js) .copy {
    display: inline-flex;
    align-items: center;
  }
  @media (hover: hover) and (pointer: fine) {
    .copy:hover {
      background: #333;
    }
  }
  .taste-links {
    display: flex;
    gap: 1.5rem;
    margin: 1.5rem 0 0;
    font-size: var(--step-body);
  }
  .taste-links a,
  .table a {
    text-decoration: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.22em;
    text-decoration-color: currentColor;
    transition: text-decoration-color var(--t-hover) ease;
  }
  .table a {
    text-decoration-color: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .taste-links a:hover {
      text-decoration-color: transparent;
    }
    .table a:hover {
      text-decoration-color: currentColor;
    }
  }

  .specimens {
    margin-top: clamp(9rem, 16svh, 10rem);
  }
  /* Each figure is sized by its own column, so the figure and its caption always fit beside
     each other: --fig is resolved inside the .specimen container. */
  .specimen {
    --fig: min(19rem, 36cqi);
    display: flex;
    grid-column: span 6;
    align-items: flex-start;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    margin: 0;
    container-type: inline-size;
  }
  .specimen figcaption {
    max-width: 12ch;
    padding-top: 0.35rem;
    color: var(--paper-muted);
    font-size: var(--step-body);
    line-height: 1.35;
  }
  /* Ends on the figures' baseline, so the section edge reads as the line they stand on.
     Only the bottom is cut: the optically aligned left side bearing stays whole. */
  .cut {
    height: calc(var(--fig) * 0.762);
    overflow: hidden;
    overflow: visible clip;
  }
  .figure {
    margin: 0 0 0 -0.06em;
    font-size: var(--fig);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.065em;
    white-space: nowrap;
  }

  /* ------------------------------------------------------------ open source */

  .oss {
    padding-top: var(--section);
  }
