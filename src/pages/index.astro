---
import "../styles/home.css";
import Icon from "../components/Icon.astro";
import Cinetic from "../components/home/Cinetic.astro";
import Close from "../components/home/Close.astro";
import Earshot from "../components/home/Earshot.astro";
import Intro from "../components/home/Intro.astro";
import Projects from "../components/home/Projects.astro";
import Recognition from "../components/home/Recognition.astro";
import TasteCode from "../components/home/TasteCode.astro";
import TasteSkill from "../components/home/TasteSkill.astro";
import Base from "../layouts/Base.astro";
import { PROJECTS } from "../lib/projects";

const EMAIL = "lexn.lin@gmail.com";
/** Total installs across the Taste Skill skills, from skills.sh (13 October 2026). Update by hand. */
const TASTE_INSTALLS = 5_200_000;

const find = (name: string) => PROJECTS.find((p) => p.name === name);
const taste = find("taste-skill")!;
const tastecode = find("tastecode")!;
const earshot = find("earshot")!;
const cinetic = find("cinetic")!;
// The open-source index, in this order. Every other repo stays on GitHub.
const SHOWN = [
  "unlazy",
  "open-water",
  "lumenshaders",
  "prompt-library",
  "kimi-code-desktop",
  "todobar",
];
const projects = SHOWN.map(find).filter((p) => p !== undefined);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Leon Lin",
  url: "https://leonlin.de",
  email: `mailto:${EMAIL}`,
  address: { "@type": "PostalAddress", addressLocality: "Munich", addressCountry: "DE" },
  sameAs: ["https://x.com/LexnLin", "https://github.com/Leonxlnx", "https://www.tasteskill.dev"],
};
---

<Base
  title="Leon Lin"
  description="I build tools that give AI good taste. Creator of Taste Skill, high school student in Munich."
  twimg
  header={false}
  jsonLd={jsonLd}
  expect="hero-foot"
  theme="#f2f2f2"
>
  <main>
    <Intro email={EMAIL} />
    <TasteSkill taste={taste} installs={TASTE_INSTALLS} />
    <div class="work">
      <TasteCode project={tastecode} />
      <Earshot project={earshot} />
      <Cinetic project={cinetic} />
    </div>
    <Projects projects={projects} />
    <Recognition />
  </main>

  <Close email={EMAIL}>
    <button class="motion" type="button" aria-pressed="false" hidden>
      <Icon name="pause" size={14} />
      <span class="sr-only">Pause moving pictures</span>
    </button>
  </Close>

  <script>
    import "../scripts/home";
  </script>
</Base>

<style>
  /* The dark run starts on a clean cut under the paper, with one soft light falling from that
     edge; the rest of it is the plain ground. */
  .work {
    background: radial-gradient(70% 36rem at 50% 0, rgb(255 255 255 / 0.055), transparent) no-repeat, var(--bg);
  }

  /* Pause for everything that moves on its own: the reel, the films, the waveform and the
     collage (WCAG 2.2.2). It rides in the bottom corner, out of the way, and its place in the page is just
     under the reel: once that comes up, it parks there and scrolls away with it, so it is on
     screen as long as the reel is and never lands on the email. It takes no room in the page:
     the margins cancel its height. A hairline edge keeps it apart from the dark run; it is
     solid, since a blurred sticky button would cost a pass every frame. */
  .motion {
    --park: 1rem;
    position: sticky;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 20;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: calc(var(--park) - var(--reel-foot)) max(var(--pad), env(safe-area-inset-right))
      calc(var(--reel-foot) - var(--park) - 2.75rem) auto;
    border-radius: 999px;
    background: #141414;
    color: #ededed;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14);
    opacity: 0;
    transition:
      transform var(--t-press) var(--ease-out),
      opacity var(--t-ui) var(--ease-out);
    pointer-events: none;
  }
  .motion[hidden] {
    display: none;
  }
  /* It shows while something that moves on its own is on screen (the page script marks the
     page), and always when the keyboard reaches it. */
  :global(.has-motion) .motion,
  .motion:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }
  /* A dark ring around a light one, so focus shows on the dark run and on paper alike. The light
     ring covers the hairline edge. */
  .motion:focus-visible {
    outline: 2px solid #141414;
    outline-offset: 2px;
    box-shadow: 0 0 0 2px #ededed;
  }
  .motion:active {
    transform: scale(0.94);
  }
</style>
