---
import "@fontsource-variable/geist";
import "../styles/global.css";

import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import Analytics from "@vercel/analytics/astro";
import IconSprite from "../components/IconSprite.astro";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description: string;
  /** Hotlinks media from Twitter's CDN. */
  twimg?: boolean;
  /** Renders the shared header. The homepage draws its own inside the hero. */
  header?: boolean;
  /** Structured data for search engines, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>;
  /**
   * Id of an element to hold the first render for (rel="expect"). The arriving page of a view
   * transition is captured on its first frame, so anything named in pagereveal must be parsed
   * by then.
   */
  expect?: string;
  /** Browser chrome colour: the page's first ground. */
  theme?: string;
}
const { title, description, twimg = false, header = true, jsonLd, expect, theme = "#0a0a0a" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL("/og.png", Astro.site).href : "/og.png";

/*
 * View transitions between / and /demos. The shared elements (the name and the nav) are named
 * by an inline classic script in <head>, because a deferred module can miss pagereveal. Names
 * live for one transition: set on the leaving page in pageswap and on the arriving one in
 * pagereveal, and cleared on finish so a bfcache restore starts clean. The home name is paired
 * only on one line; the two-line phone name comes up with its page. The arriving page gets
 * html.vt, so its intro can stand down, and window.__vt = the transition's finished promise, so
 * the page scripts wait for the transition instead of competing with it. Lines are joined to
 * keep it small, so every statement ends in a semicolon and there are no line comments.
 */
const vtNames = String.raw`(() => {
  const named = [];
  const q = (s) => document.querySelector(s);
  const clear = () => named.splice(0).forEach((el) => (el.style.viewTransitionName = ""));
  const name = (el, v) => {
    const r = el && el.getBoundingClientRect();
    if (r?.bottom > 0 && r.top < innerHeight) return named.push(el), (el.style.viewTransitionName = v);
  };
  const run = (e, out) => {
    clear();
    const vt = e.viewTransition;
    if (!vt) return;
    vt.finished.then(clear);
    if (!out) (window.__vt = vt.finished), document.documentElement.classList.add("vt");
    const n = q(".name,.site-title");
    if (!n?.matches(".name") || n.offsetHeight < parseFloat(getComputedStyle(n).fontSize)) name(n, "name");
    name(q(".nav"), "nav");
  };
  addEventListener("pageswap", (e) => run(e, 1));
  addEventListener("pagereveal", run);
})();`.replace(/\s*\n\s*/g, "");
---

<!doctype html>
<html lang="en" class={header ? "has-title" : "has-name"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script is:inline set:html={vtNames} />
    <link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />
    {
      /* Hold the first render only when a view transition can run (a same-site arrival, not a
         reload, motion allowed); every other load paints as soon as it can. */
      expect && (
        <script
          is:inline
          set:html={`(()=>{const a=window.navigation&&navigation.activation;if(a&&a.from&&a.navigationType!=="reload"&&matchMedia("(prefers-reduced-motion: no-preference)").matches){const l=document.createElement("link");l.rel="expect";l.href="#${expect}";l.setAttribute("blocking","render");document.head.append(l)}})()`}
        />
      )
    }
    {twimg && <meta name="referrer" content="no-referrer" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme} />
    <meta name="color-scheme" content="dark" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {twimg && <link rel="preconnect" href="https://pbs.twimg.com" />}
    {twimg && <link rel="preconnect" href="https://video.twimg.com" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Leon Lin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@LexnLin" />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <IconSprite />

    {
      header && (
        <header class="top">
          <a class="site-title" href="/">
            Leon Lin
          </a>
          <Nav path={path} />
        </header>
      )
    }

    <slot />

    <script>
      import "../scripts/smooth";
    </script>

    <!-- Vercel Web Analytics: page views only, no cookies. Enable it in the Vercel project. -->
    <Analytics />
  </body>
</html>

<style is:global>
  /* Opt-in, so reduced motion and engines without cross-document transitions (Firefox)
     navigate as before. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }

  /* The name and nav are objects: they travel while visible, on the morph curve. */
  ::view-transition-group(name),
  ::view-transition-group(nav) {
    animation-duration: var(--t-page);
    animation-timing-function: var(--ease-in-out);
  }
  /* The name is 264px on home and 17px on /demos, and a small snapshot blown up goes soft.
     So the big one carries the morph and the small one shows only near its own size. The
     pseudo-elements are styled by the arriving page, which tells the direction (its <html>
     carries has-title or has-name). The fades inherit this from the pair, so a name without a
     partner still comes up with the page. */
  :root.has-title::view-transition-image-pair(name) {
    animation-delay: calc(var(--t-page) * 0.65);
    animation-duration: calc(var(--t-page) * 0.35);
  }
  :root.has-name::view-transition-image-pair(name) {
    animation-duration: calc(var(--t-page) * 0.35);
  }
  /* While a transition runs, the small title is captured as its glyph box cut on the baseline,
     like the home .name, so the two land on each other instead of double-exposing. The padding
     is its touch target and comes back when the transition ends. On a phone the name is two
     lines and is not paired at all (head script), so each side comes up with its page. */
  :active-view-transition .site-title {
    height: 0.755em;
    padding: 0;
    margin: 0;
    line-height: 0.8;
  }

  /* The new page comes up over the old one, which stays put underneath, so neither blends
     additively and the page never dips through a half-dark frame. A named element with no
     partner on the old page comes up with it. */
  ::view-transition-old(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-new(root),
  ::view-transition-new(*):only-child {
    animation: page-in var(--t-page) var(--ease-out) both;
    mix-blend-mode: normal;
  }
  /* A named element with no partner on the new page leaves at the same pace instead of hanging
     over the arriving page. */
  ::view-transition-old(*):only-child {
    animation: page-out var(--t-page) var(--ease-out) both;
  }
  @keyframes page-in {
    from {
      opacity: 0;
    }
  }
  @keyframes page-out {
    to {
      opacity: 0;
    }
  }
</style>
