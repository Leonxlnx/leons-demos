---
import "@fontsource-variable/geist";
import "../styles/global.css";

import IconSprite from "../components/IconSprite.astro";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description: string;
  /** Hotlinks media from Twitter's CDN. */
  twimg?: boolean;
  /** Renders the shared header. The homepage draws its own inside the hero. */
  header?: boolean;
  /** Structured data for search engines, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}
const { title, description, twimg = false, header = true, jsonLd } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL("/og.png", Astro.site).href : "/og.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    {twimg && <meta name="referrer" content="no-referrer" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {twimg && <link rel="preconnect" href="https://pbs.twimg.com" />}
    {twimg && <link rel="preconnect" href="https://video.twimg.com" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Leon Lin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@LexnLin" />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <IconSprite />
    <canvas class="bg" aria-hidden="true"></canvas>

    {
      header && (
        <header class="top">
          <a class="site-title" href="/">
            Leon Lin
          </a>
          <Nav path={path} />
        </header>
      )
    }

    <slot />

    <script>
      import "../scripts/background";
    </script>
  </body>
</html>
